# --- порты на хосте ---
APP_PORT=8080
POSTGRES_PORT=5434

# --- база ---
POSTGRES_USER=vendetta
POSTGRES_PASSWORD=vendetta
POSTGRES_DB=vendetta

# Используется только при локальном запуске (make dev).
# Внутри docker приложение ходит к базе по имени сервиса postgres.
DATABASE_URL=postgres://vendetta:vendetta@localhost:5434/vendetta?sslmode=disable

# --- приложение ---
LISTEN_ADDR=:8080
SESSION_TTL=168h
# true — только при работе за HTTPS
COOKIE_SECURE=false
# Часовой пояс для дат в интерфейсе (центральноевропейский)
TZ=Europe/Berlin
# debug / info / warn / error. На debug видно каждый опрос лобби; на info
# воркер отчитывается сводкой раз в час.
LOG_LEVEL=info

# Применяются один раз, при создании рута.
# Почта необязательна — входить можно по нику. Если ник не задан,
# он берётся из части адреса до «собаки».
ROOT_EMAIL=root@vendetta.local
ROOT_NICKNAME=root
ROOT_PASSWORD=change-me-please-123

# --- слежение за лобби Supremacy 1914 ---
# Пока S1914_USER пуст, воркер не запускается и в игру никто не ходит.
# Ник и пароль от игрового аккаунта (не от админки).
S1914_USER=
S1914_PASSWORD=
# Языковой раздел лобби. Это не косметика: в ru и en висят РАЗНЫЕ игры
# с одинаковыми названиями, так что ставьте тот, в котором играете.
S1914_LANG=ru
# Названия игр через запятую. Совпадение — по подстроке без учёта регистра:
# «great war» поймает и «The Great War», и «[Speed] - The Great War».
# Оставьте пустым, чтобы сообщать про все игры лобби без разбора.
S1914_WATCH_TITLES=
# Как часто опрашивать лобби. Чаще раза в 30 секунд приложение не даст.
S1914_POLL_INTERVAL=1m

# --- уведомления в телеграм ---
# Куда воркер сообщает о найденных играх. Пока не задано, сообщения остаются
# в логе приложения. Задавать нужно оба значения или ни одного.
# Токен выдаёт @BotFather при создании бота.
TELEGRAM_BOT_TOKEN=
# Чат: число (у групп и каналов отрицательное) либо @username публичного канала.
# Свой ID можно узнать у @userinfobot; в группу и канал бота надо добавить.
TELEGRAM_CHAT_ID=
# Тема (топик) внутри группы-форума. Оставьте пустым для обычного чата, канала
# или чтобы писать в тему «General». ID виден в ссылке на сообщение темы:
# t.me/c/<чат>/<ЭТО ЧИСЛО>/<сообщение>.
TELEGRAM_TOPIC_ID=
