{
  "manifest_version": 3,
  "name": "Админка",
  "version": "0.7.1",
  "description": "База игроков прямо в браузере.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Админка",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://supremacy.tagumplay.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.supremacy1914.com/clients/*",
        "https://supremacy1914.com/clients/*",
        "https://www.supremacy1914.pl/clients/*",
        "https://supremacy1914.pl/clients/*",
        "https://www.supremacy1914.de/clients/*",
        "https://supremacy1914.de/clients/*",
        "https://www.supremacy1914.fr/clients/*",
        "https://supremacy1914.fr/clients/*",
        "https://www.supremacy1914.es/clients/*",
        "https://supremacy1914.es/clients/*",
        "https://www.supremacy1914.it/clients/*",
        "https://supremacy1914.it/clients/*",
        "https://www.supremacy1914.nl/clients/*",
        "https://supremacy1914.nl/clients/*",
        "https://www.supremacy1914.gr/clients/*",
        "https://supremacy1914.gr/clients/*",
        "https://www.supremacy1914.at/clients/*",
        "https://supremacy1914.at/clients/*"
      ],
      "js": [
        "game-main.js"
      ],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.supremacy1914.com/clients/*",
        "https://supremacy1914.com/clients/*",
        "https://www.supremacy1914.pl/clients/*",
        "https://supremacy1914.pl/clients/*",
        "https://www.supremacy1914.de/clients/*",
        "https://supremacy1914.de/clients/*",
        "https://www.supremacy1914.fr/clients/*",
        "https://supremacy1914.fr/clients/*",
        "https://www.supremacy1914.es/clients/*",
        "https://supremacy1914.es/clients/*",
        "https://www.supremacy1914.it/clients/*",
        "https://supremacy1914.it/clients/*",
        "https://www.supremacy1914.nl/clients/*",
        "https://supremacy1914.nl/clients/*",
        "https://www.supremacy1914.gr/clients/*",
        "https://supremacy1914.gr/clients/*",
        "https://www.supremacy1914.at/clients/*",
        "https://supremacy1914.at/clients/*"
      ],
      "js": [
        "game-content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
