{
  "manifest_version": 3,
  "name": "Админка",
  "version": "0.3.0",
  "description": "База игроков прямо в браузере.",
  "action": {
    "default_title": "Админка",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage"],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.supremacy1914.com/clients/*",
        "https://supremacy1914.com/clients/*"
      ],
      "js": ["game-main.js"],
      "world": "MAIN",
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.supremacy1914.com/clients/*",
        "https://supremacy1914.com/clients/*"
      ],
      "js": ["game-content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
