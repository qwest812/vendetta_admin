{{/* Список найденных игроков. Общий для поиска и карточки клана, поэтому
     пустой случай подписывается через .Empty, а пометки «во враги»
     и «в друзья» — через .CanMark: на карточке клана их нет. */}}
{{define "results"}}
{{$csrf := .CSRFToken}}
{{$canMark := .CanMark}}
{{$enemies := .MarkedEnemies}}
{{$friends := .MarkedFriends}}
{{$enemyWords := .EnemyWords}}
{{$friendWords := .FriendWords}}
{{/* Запас общий на оба списка, поэтому гаснут обе пометки разом. */}}
{{$full := .RelationFull}}
{{if .Players}}
    <div class="players">
        {{range .Players}}
            {{/* Вся строка ведёт на карточку, но пометка живёт рядом со
                 ссылкой, а не внутри неё: кнопка внутри <a> и ломает вёрстку,
                 и уводила бы на карточку вместо нажатия. */}}
            <div class="player-row">
                <a class="player-link" href="/players/{{.ID}}">
                    <div class="player-main">
                        <span class="nick">{{.Nickname}}</span>
                        {{if .ClanName}}<span class="clan clan-{{.ClanStatus}}">[{{.ClanName}}]</span>{{end}}
                        {{if .GameID}}<span class="game-id">ID {{.GameID}}</span>{{end}}
                    </div>
                    <div class="player-traits">
                        {{range .Traits}}
                            <span class="tag {{if .IsNegative}}neg{{else if .IsPositive}}pos{{else}}zero{{end}}">{{.Name}}</span>
                        {{end}}
                    </div>
                </a>
                {{if $canMark}}
                    <div class="marks">
                        {{template "mark" (dict "ID" .ID "Marked" (index $friends .ID) "Full" $full "CSRFToken" $csrf "Words" $friendWords)}}
                        {{template "mark" (dict "ID" .ID "Marked" (index $enemies .ID) "Full" $full "CSRFToken" $csrf "Words" $enemyWords)}}
                    </div>
                {{end}}
            </div>
        {{end}}
    </div>
    {{if ge (len .Players) .Limit}}
        <p class="muted center">{{t "results.truncated" .Limit}}</p>
    {{end}}
{{else}}
    <div class="card empty">
        {{if .Empty}}
            {{.Empty}}
        {{else if .Query}}
            {{t "results.empty.query" .Query}}
        {{else}}
            {{t "results.empty.all"}}
        {{end}}
    </div>
{{end}}
{{end}}

{{/* Пометка одной строки — «во враги» или «в друзья», смотря какие слова
     пришли. Живёт в трёх видах: кнопка, раскрытая форма заметки и погашенная
     кнопка, когда места в списках нет. Отдаётся и вместе со списком, и
     отдельно — в ответ на нажатие, чтобы поиск не перезагружался. */}}
{{define "mark"}}
{{$w := .Words}}
{{if .Form}}
    {{/* Пока форма открыта, в списке ничего не изменилось: запись делает
         только «Сохранить». Пустую заметку сохранить можно — иногда нужна
         сама пометка. */}}
    <form class="mark-form" method="post" action="/{{$w.Path}}/{{.ID}}/mark"
          hx-post="/{{$w.Path}}/{{.ID}}/mark" hx-target="this" hx-swap="outerHTML">
        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
        {{if .Error}}<p class="error">{{.Error}}</p>{{end}}
        <textarea name="comment" rows="2" maxlength="{{.CommentMax}}"
                  placeholder="{{t "rel.comment.placeholder"}}">{{.Comment}}</textarea>
        <p class="muted">{{t "rel.comment.private"}}</p>
        <div class="mark-actions">
            <button type="submit">{{if .Marked}}{{t "common.save"}}{{else}}{{t $w.MarkAdd}}{{end}}</button>
            {{/* Отмена перечитывает пометку с сервера, а не прячет форму:
                 состояние могло измениться в другой вкладке. */}}
            <button class="link" type="button"
                    hx-get="/{{$w.Path}}/{{.ID}}/mark" hx-target="closest .mark-form"
                    hx-swap="outerHTML">{{t "common.cancel"}}</button>
        </div>
    </form>
{{else if .Full}}
    {{/* Запас карточек кончился. Кнопку гасим, а не прячем: исчезнувшая
         кнопка читается как поломка, а погашенная — как «нельзя»,
         и причина написана в подсказке. */}}
    <button class="mark {{$w.Class}}" type="button" disabled title="{{t "rel.full.title"}}">{{t $w.MarkAdd}}</button>
{{else}}
    {{/* Ссылка, а не кнопка: с htmx она раскрывает форму на месте, а без
         него ведёт на карточку игрока — там та же заметка правится обычной
         формой, и без скриптов пометка не пропадает. */}}
    <a class="mark {{if .Marked}}done {{end}}{{$w.Class}}" href="/players/{{.ID}}"
       hx-get="/{{$w.Path}}/{{.ID}}/mark/form" hx-target="this" hx-swap="outerHTML"
       title="{{if .Marked}}{{t $w.DoneTitle}}{{else}}{{t $w.AddTitle}}{{end}}">{{if .Marked}}{{t $w.MarkDone}}{{else}}{{t $w.MarkAdd}}{{end}}</a>
{{end}}
{{end}}
