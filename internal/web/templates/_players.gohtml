{{/* Список найденных игроков. Общий для поиска и карточки клана, поэтому
     пустой случай подписывается через .Empty, а пометки «во враги»
     и «в друзья» — через .CanMark: на карточке клана их нет. */}}
{{define "results"}}
{{$csrf := .CSRFToken}}
{{$canMark := .CanMark}}
{{$enemies := .MarkedEnemies}}
{{$friends := .MarkedFriends}}
{{$enemyWords := .EnemyWords}}
{{$friendWords := .FriendWords}}
{{/* Запас общий на оба списка, поэтому гаснут обе пометки разом. */}}
{{$full := .RelationFull}}
{{if .Players}}
    <div class="players">
        {{range .Players}}
            {{/* Вся строка ведёт на карточку, но пометка живёт рядом со
                 ссылкой, а не внутри неё: кнопка внутри <a> и ломает вёрстку,
                 и уводила бы на карточку вместо нажатия. */}}
            <div class="player-row">
                <a class="player-link" href="/players/{{.ID}}">
                    <div class="player-main">
                        <span class="nick">{{.Nickname}}</span>
                        {{if .ClanName}}<span class="clan clan-{{.ClanStatus}}">[{{.ClanName}}]</span>{{end}}
                        {{if .GameID}}<span class="game-id">ID {{.GameID}}</span>{{end}}
                    </div>
                    <div class="player-traits">
                        {{range .Traits}}
                            <span class="tag {{if .IsNegative}}neg{{else if .IsPositive}}pos{{else}}zero{{end}}">{{.Name}}</span>
                        {{end}}
                    </div>
                </a>
                {{if $canMark}}
                    <div class="marks">
                        {{template "mark" (dict "ID" .ID "Marked" (index $friends .ID) "Full" $full "CSRFToken" $csrf "Words" $friendWords)}}
                        {{template "mark" (dict "ID" .ID "Marked" (index $enemies .ID) "Full" $full "CSRFToken" $csrf "Words" $enemyWords)}}
                    </div>
                {{end}}
            </div>
        {{end}}
    </div>
    {{if ge (len .Players) .Limit}}
        <p class="muted center">{{t "results.truncated" .Limit}}</p>
    {{end}}
{{else}}
    <div class="card empty">
        {{if .Empty}}
            {{.Empty}}
        {{else if .Query}}
            {{t "results.empty.query" .Query}}
        {{else if .Status}}
            {{t "results.empty.status"}}
        {{else}}
            {{t "results.empty.all"}}
        {{end}}
    </div>
{{end}}
{{end}}

{{/* Пометка одной строки — «во враги» или «в друзья», смотря какие слова
     пришли. Отдаётся и вместе со списком, и отдельно — в ответ на нажатие,
     чтобы поиск не перезагружался и не сбрасывался. */}}
{{define "mark"}}
{{$w := .Words}}
{{if .Marked}}
    <a class="mark done {{$w.Class}}" href="/{{$w.Path}}" title="{{t $w.DoneTitle}}">{{t $w.MarkDone}}</a>
{{else if .Full}}
    {{/* Запас карточек кончился. Кнопку гасим, а не прячем: исчезнувшая
         кнопка читается как поломка, а погашенная — как «нельзя»,
         и причина написана в подсказке. */}}
    <button class="mark {{$w.Class}}" type="button" disabled title="{{t "rel.full.title"}}">{{t $w.MarkAdd}}</button>
{{else}}
    <form method="post" action="/{{$w.Path}}/{{.ID}}/mark"
          hx-post="/{{$w.Path}}/{{.ID}}/mark" hx-target="this" hx-swap="outerHTML">
        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
        <button class="mark {{$w.Class}}" type="submit" title="{{t $w.AddTitle}}">{{t $w.MarkAdd}}</button>
    </form>
{{end}}
{{end}}
