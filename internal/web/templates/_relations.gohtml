{{/* Личный список игроков: враги и друзья. Разделы устроены одинаково —
     поиск, выпадающий список, комментарий, — поэтому разметка у них общая,
     а слова приходят в .Words. */}}
{{define "relation-page"}}
{{$words := .Words}}
<div class="card">
    <h1>{{$words.Title}}</h1>
    <p class="muted">{{$words.Intro}}</p>
</div>

<div class="card">
    <h1>Добавить</h1>
    {{if .Error}}<p class="error">{{.Error}}</p>{{end}}

    {{/* Поиск вынесен из формы намеренно: иначе Enter в нём отправлял бы
         форму, не дав выбрать из подобранного. */}}
    <div class="filters">
        <input type="search" name="q" value="{{.Query}}" placeholder="Найти по игровому ID или нику"
               autocomplete="off"
               hx-get="/{{$words.Path}}/search" hx-trigger="input changed delay:250ms, search"
               hx-target="#candidates" hx-swap="innerHTML"
               hx-indicator="#searching">
        <span id="searching" class="htmx-indicator muted">ищем…</span>
    </div>

    <form method="post" action="/{{$words.Path}}">
        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
        <label class="block">
            Комментарий
            <textarea name="comment" rows="2" maxlength="4000" placeholder="За что">{{.Comment}}</textarea>
        </label>
        <div id="candidates">{{template "candidates" .}}</div>
    </form>
</div>

<div class="card">
    <h1>Список</h1>
    {{$csrf := .CSRFToken}}
    <ul class="notes enemies">
        {{range .List}}
            {{$p := .Player}}
            <li>
                <div class="note-head">
                    <a class="nick" href="/players/{{$p.ID}}">{{$p.Nickname}}</a>
                    {{if $p.ClanName}}<span class="clan clan-{{$p.ClanStatus}}">[{{$p.ClanName}}]</span>{{end}}
                    {{if $p.GameID}}<span class="game-id">ID {{$p.GameID}}</span>
                    {{else}}<span class="muted">без ID</span>{{end}}
                    <span class="muted">{{datetime .CreatedAt}}</span>
                    <form method="post" action="/{{$words.Path}}/{{$p.ID}}/delete"
                          onsubmit="return confirm('{{printf $words.Confirm $p.Nickname}}')">
                        <input type="hidden" name="csrf_token" value="{{$csrf}}">
                        <button class="link" type="submit">убрать</button>
                    </form>
                </div>
                {{/* Комментарий правится на месте: отдельная страница ради
                     одного поля была бы лишним шагом. */}}
                <form class="enemy-comment" method="post" action="/{{$words.Path}}/{{$p.ID}}">
                    <input type="hidden" name="csrf_token" value="{{$csrf}}">
                    <textarea name="comment" rows="2" maxlength="4000" placeholder="За что">{{.Comment}}</textarea>
                    <button type="submit">Сохранить</button>
                </form>
            </li>
        {{else}}
            <li class="muted">{{$words.Empty}}</li>
        {{end}}
    </ul>
</div>
{{end}}

{{/* Подбор карточки для добавления: что нашлось по набранному. Отдаётся
     и целой страницей, и отдельно — в ответ на живой ввод. */}}
{{define "candidates"}}
{{$marked := .Marked}}
{{if .Candidates}}
    <div class="row-form">
        <label>
            {{.Words.Pick}}
            <select name="player_id">
                {{range .Candidates}}
                    {{/* Уже добавленных из списка не убираем, но и выбрать
                         не даём: иначе непонятно, куда делся найденный. */}}
                    <option value="{{.ID}}" {{if index $marked .ID}}disabled{{end}}>{{.Nickname}}{{if .ClanName}} [{{.ClanName}}]{{end}}{{if .GameID}} — ID {{.GameID}}{{else}} — без ID{{end}}{{if index $marked .ID}} — уже в списке{{end}}</option>
                {{end}}
            </select>
        </label>
        {{if .CanAdd}}
            <button type="submit">Добавить</button>
        {{else}}
            <span class="muted">{{.Words.AllListed}}</span>
        {{end}}
    </div>
    {{if ge (len .Candidates) .Limit}}
        <p class="muted">Показаны первые {{.Limit}} — уточните запрос.</p>
    {{end}}
{{else if .Query}}
    <p class="muted">
        По запросу «{{.Query}}» никого не нашли. В список записываются только те,
        у кого есть карточка в базе, — новую заводит админ на главной.
    </p>
{{else}}
    <p class="muted">Наберите ник или игровой ID — подходящие карточки появятся в списке.</p>
{{end}}
{{end}}
