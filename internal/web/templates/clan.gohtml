{{define "title"}}{{.Clan.Name}} — Vendetta{{end}}

{{define "content"}}
{{$c := .Clan}}
<div class="card">
    <div class="card-head">
        <div>
            <h1 class="nick-big">{{$c.Name}}</h1>
            <span class="badge clan-{{$c.Status}}">{{clanStatus $c.Status}}</span>
            <span class="muted">{{t "clan.players" $c.Players}}</span>
        </div>
        <a class="button ghost" href="/clans">{{t "clan.all"}}</a>
    </div>

    {{if .CurrentUser.IsAdmin}}
        <form class="row-form" method="post" action="/clans/{{$c.ID}}">
            <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
            <input type="hidden" name="back" value="/clans/{{$c.ID}}">
            <label>
                {{t "common.name"}}
                <input name="name" value="{{$c.Name}}" maxlength="64" required autocomplete="off">
            </label>
            <label class="narrow">
                {{t "common.status"}}
                {{$cur := $c.Status}}
                <select name="status">
                    {{range .Statuses}}<option value="{{.}}" {{if eq . $cur}}selected{{end}}>{{clanStatus .}}</option>{{end}}
                </select>
            </label>
            <button type="submit">{{t "common.save"}}</button>
        </form>
    {{end}}
</div>

<h1 class="section">{{t "clan.roster"}}</h1>
{{template "results" (dict "Players" .Players "Limit" .Limit "Empty" (t "clan.empty"))}}
{{end}}
