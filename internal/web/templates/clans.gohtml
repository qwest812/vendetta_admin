{{define "title"}}{{t "clans.title"}}{{end}}

{{define "content"}}
<div class="card">
    <h1>{{t "nav.clans"}}</h1>
    <p class="muted">
        {{t "clans.intro"}}
    </p>
</div>

{{if .CurrentUser.IsAdmin}}
    <div class="card">
        <h1>{{t "clans.new"}}</h1>
        {{if .Error}}<p class="error">{{.Error}}</p>{{end}}
        <form class="row-form" method="post" action="/clans">
            <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
            <label>
                {{t "common.name"}}
                <input name="name" maxlength="64" required autocomplete="off">
            </label>
            <label class="narrow">
                {{t "common.status"}}
                <select name="status">
                    {{range .Statuses}}<option value="{{.}}" {{if eq . "neutral"}}selected{{end}}>{{clanStatus .}}</option>{{end}}
                </select>
            </label>
            <button type="submit">{{t "common.add"}}</button>
        </form>
        <p class="muted">
            {{t "clans.new.note"}}
        </p>
    </div>
{{end}}

<div class="card">
    <h1>{{t "common.directory"}}</h1>
    {{$admin := .CurrentUser.IsAdmin}}
    {{$csrf := .CSRFToken}}
    {{$statuses := .Statuses}}
    {{/* stack: в строке живут статус и кнопки — на телефоне она
         раскладывается в карточку. */}}
    <div class="table-wrap">
        <table class="stack">
            <thead>
            <tr>
                <th>{{t "clans.col.clan"}}</th>
                <th class="narrow">{{t "common.status"}}</th>
                <th class="narrow">{{t "clans.col.players"}}</th>
                <th class="actions">{{t "common.actions"}}</th>
            </tr>
            </thead>
            <tbody>
            {{range .Clans}}
                {{/* Формы вынесены за таблицу: <form> нельзя размещать внутри <tr>,
                     поэтому поля связаны с ней атрибутом form. */}}
                <tr>
                    <td data-label="">
                        <a href="/clans/{{.ID}}">{{.Name}}</a>
                        {{if $admin}}<input form="clan-{{.ID}}" name="name" value="{{.Name}}" maxlength="64" required>{{end}}
                    </td>
                    <td class="narrow" data-label="{{t "common.status"}}">
                        {{if $admin}}
                            <select form="clan-{{.ID}}" name="status">
                                {{$cur := .Status}}
                                {{range $statuses}}<option value="{{.}}" {{if eq . $cur}}selected{{end}}>{{clanStatus .}}</option>{{end}}
                            </select>
                        {{else}}
                            <span class="badge clan-{{.Status}}">{{clanStatus .Status}}</span>
                        {{end}}
                    </td>
                    <td class="narrow muted" data-label="{{t "clans.col.players"}}">{{.Players}}</td>
                    <td class="actions" data-label="">
                        {{if $admin}}
                            <button form="clan-{{.ID}}" type="submit">{{t "common.save"}}</button>
                            <button form="clan-del-{{.ID}}" class="danger" type="submit">{{t "common.delete"}}</button>
                        {{end}}
                    </td>
                </tr>
            {{else}}
                <tr><td colspan="4" class="muted">{{t "clans.empty"}}</td></tr>
            {{end}}
            </tbody>
        </table>
    </div>

    {{if $admin}}
        {{range .Clans}}
            <form id="clan-{{.ID}}" method="post" action="/clans/{{.ID}}" hidden>
                <input type="hidden" name="csrf_token" value="{{$csrf}}">
                <input type="hidden" name="back" value="/clans">
            </form>
            <form id="clan-del-{{.ID}}" method="post" action="/clans/{{.ID}}/delete" hidden
                  onsubmit="return confirm('{{t "clans.delete.confirm" .Name .Players}}')">
                <input type="hidden" name="csrf_token" value="{{$csrf}}">
            </form>
        {{end}}
        <p class="muted">
            {{t "clans.delete.note"}}
        </p>
    {{end}}
</div>
{{end}}
