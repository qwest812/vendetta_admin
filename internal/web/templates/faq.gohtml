{{define "title"}}{{t "faq.title"}}{{end}}

{{define "content"}}
<div class="card">
    <h1>{{t "nav.faq"}}</h1>
    <p class="muted">{{t "faq.intro"}}</p>
</div>

<div class="card faq">
    {{/* Первый вопрос открыт: это и есть инструкция, ради которой сюда заходят. */}}
    <details open>
        <summary>{{t "faq.howto.q"}}</summary>
        <div class="faq-body">
            <p><b>{{t "faq.howto.login.h"}}</b> {{t "faq.howto.login"}}</p>

            <p><b>{{t "faq.howto.search.h"}}</b> {{t "faq.howto.search"}}</p>

            <p><b>{{t "faq.howto.card.h"}}</b> {{t "faq.howto.card"}}</p>

            <p><b>{{t "faq.howto.notes.h"}}</b> {{t "faq.howto.notes"}}</p>

            {{if .CurrentUser.IsAdmin}}
                <p><b>{{t "faq.howto.cards.h"}}</b> {{t "faq.howto.cards"}}</p>
                <p><b>{{t "faq.howto.admin.h"}}</b> {{t "faq.howto.admin"}}</p>
            {{end}}
        </div>
    </details>

    <details>
        <summary>{{t "faq.signin.q"}}</summary>
        <div class="faq-body">
            <p>{{t "faq.signin.a1"}}</p>
            <p>{{t "faq.signin.a2"}}</p>
        </div>
    </details>

    <details>
        <summary>{{t "faq.session.q"}}</summary>
        <div class="faq-body">
            <p>{{t "faq.session.a"}}</p>
        </div>
    </details>

    <details>
        <summary>{{t "faq.renamed.q"}}</summary>
        <div class="faq-body">
            <p>{{t "faq.renamed.a1"}}</p>
            <p>{{t "faq.renamed.a2"}}</p>
        </div>
    </details>

    <details>
        <summary>{{t "faq.clancolor.q"}}</summary>
        <div class="faq-body">
            <p>{{t "faq.clancolor.a1"}}</p>
            <p>{{t "faq.clancolor.a2"}}</p>
            <p>{{t "faq.clancolor.a3"}}{{if .CurrentUser.IsAdmin}} {{t "faq.clancolor.a3.admin"}}{{end}}</p>
        </div>
    </details>

    <details>
        <summary>{{t "faq.scales.q"}}</summary>
        <div class="faq-body">
            <p>{{t "faq.scales.a1"}}</p>
            <p>{{t "faq.scales.a2"}}</p>
        </div>
    </details>

    <details>
        <summary>{{t "faq.percents.q"}}</summary>
        <div class="faq-body">
            <p>{{t "faq.percents.a"}}</p>
        </div>
    </details>

    <details>
        <summary>{{t "faq.notes.q"}}</summary>
        <div class="faq-body">
            <p>{{t "faq.notes.a"}}</p>
        </div>
    </details>

    <details>
        <summary>{{t "faq.lists.q"}}</summary>
        <div class="faq-body">
            <p>{{t "faq.lists.a1"}}</p>
            <p>{{t "faq.lists.a2"}}</p>
            <p>{{t "faq.lists.a3"}}</p>
            <p>{{t "faq.lists.a4"}}</p>
        </div>
    </details>

    <details>
        <summary>{{t "faq.rights.q"}}</summary>
        <div class="faq-body">
            <table>
                <thead>
                <tr>
                    <th>{{t "audit.action"}}</th>
                    <th class="narrow">{{t "role.user"}}</th>
                    <th class="narrow">{{t "faq.rights.admin"}}</th>
                    <th class="narrow">{{t "role.root"}}</th>
                </tr>
                </thead>
                <tbody>
                {{$yes := t "faq.rights.yes"}}
                <tr><td>{{t "faq.rights.search"}}</td><td class="yes">{{$yes}}</td><td class="yes">{{$yes}}</td><td class="yes">{{$yes}}</td></tr>
                <tr><td>{{t "faq.rights.notes"}}</td><td class="yes">{{$yes}}</td><td class="yes">{{$yes}}</td><td class="yes">{{$yes}}</td></tr>
                <tr><td>{{t "faq.rights.lists"}}</td><td class="yes">{{$yes}}</td><td class="yes">{{$yes}}</td><td class="yes">{{$yes}}</td></tr>
                <tr><td>{{t "faq.rights.othernotes"}}</td><td class="no">—</td><td class="yes">{{$yes}}</td><td class="yes">{{$yes}}</td></tr>
                <tr><td>{{t "faq.rights.cards"}}</td><td class="no">—</td><td class="yes">{{$yes}}</td><td class="yes">{{$yes}}</td></tr>
                <tr><td>{{t "faq.rights.feedback"}}</td><td class="no">—</td><td class="yes">{{$yes}}</td><td class="yes">{{$yes}}</td></tr>
                <tr><td>{{t "faq.rights.access"}}</td><td class="no">—</td><td class="yes">{{$yes}}</td><td class="yes">{{$yes}}</td></tr>
                <tr><td>{{t "faq.rights.audit"}}</td><td class="no">—</td><td class="yes">{{$yes}}</td><td class="yes">{{$yes}}</td></tr>
                <tr><td>{{t "faq.rights.delcards"}}</td><td class="no">—</td><td class="no">—</td><td class="yes">{{$yes}}</td></tr>
                <tr><td>{{t "faq.rights.delusers"}}</td><td class="no">—</td><td class="no">—</td><td class="yes">{{$yes}}</td></tr>
                {{/* Доступ к «Играм» — персональный, его открывает рут. */}}
                {{$granted := t "faq.rights.granted"}}
                <tr><td>{{t "faq.rights.games"}}</td><td>{{$granted}}</td><td>{{$granted}}</td><td class="yes">{{$yes}}</td></tr>
                <tr><td>{{t "faq.rights.hero"}}</td><td class="no">—</td><td class="no">—</td><td class="yes">{{$yes}}</td></tr>
                <tr><td>{{t "faq.rights.checks"}}</td><td class="no">—</td><td class="no">—</td><td class="yes">{{$yes}}</td></tr>
                </tbody>
            </table>
        </div>
    </details>

    {{if .CurrentUser.IsAdmin}}
        <details>
            <summary>{{t "faq.grant.q"}}</summary>
            <div class="faq-body">
                <p>{{t "faq.grant.a1"}}</p>
                <p>{{t "faq.grant.a2"}}</p>
            </div>
        </details>
    {{end}}

    <details>
        <summary>{{t "faq.bug.q"}}</summary>
        <div class="faq-body">
            <p>{{t "faq.bug.a"}}</p>
        </div>
    </details>
</div>
{{end}}
