{{define "title"}}Партия — Vendetta{{end}}

{{define "content"}}
<div class="card">
    <div class="card-head">
        <h1>
            {{if .Game}}{{.Game.Title}}{{else}}Партия {{.GameID}}{{end}}
            <span class="game-id">ID {{.GameID}}</span>
        </h1>
        <div class="head-actions">
            <a class="button ghost" href="/games">Все партии</a>
        </div>
    </div>

    {{if .Error}}<p class="error">{{.Error}}</p>{{end}}

    {{if .Game}}
        <p class="muted">
            Состояние: {{.Game.State}}{{if .Game.Day}}, день {{.Game.Day}}{{end}},
            игроков {{.Game.Players}}{{if .Game.Language}}, язык {{.Game.Language}}{{end}}{{if not .Game.Started.IsZero}},
            начата {{datetime .Game.Started}}{{end}}{{/* Номер аккаунта проекта — внутренняя кухня,
            и «мы» здесь означает именно его, а не того, кто смотрит. */}}{{if and .CurrentUser.IsRoot .Game.PlayerID}},
            аккаунт проекта — игрок №{{.Game.PlayerID}}{{end}}.
        </p>
        {{if not .Ours}}
            {{/* Чужая партия: общий аккаунт в ней не играет, но смотреть
                 со стороны игра не мешает — она отдаёт состояние партии
                 и без входа в неё. */}}
            <p class="muted">
                В этой партии общий аккаунт проекта не играет, поэтому смотрим
                на неё со стороны: карта, состав, кланы и коалиции видны, а вот
                делать в партии что-либо — призывать пехоту, например — некому.
                Партия про такой взгляд не узнаёт: входом в неё он не считается.
            </p>
        {{end}}
    {{end}}
</div>

{{if and .CurrentUser.IsRoot .Ours}}
<div class="card">
    <h1>Что делаем сами</h1>
    {{$t := .Task}}
    <div class="row-form">
        <form method="post" action="/games/{{.GameID}}/hero">
            <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
            <input type="hidden" name="title" value="{{if .Game}}{{.Game.Title}}{{end}}">
            <input type="hidden" name="on" value="{{if and $t $t.HeroDeploy}}0{{else}}1{{end}}">
            <button type="submit">
                {{if and $t $t.HeroDeploy}}Выключить призыв пехоты{{else}}Включить призыв пехоты{{end}}
            </button>
        </form>
        {{/* Ручной призыв стоит рядом с переключателем: проверять кнопку,
             дожидаясь тика воркера, невозможно. */}}
        <form method="post" action="/games/{{.GameID}}/hero/run">
            <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
            <button type="submit">Призвать сейчас</button>
        </form>
        <p class="muted">
            {{if and $t $t.HeroDeploy}}
                Включено: воркер заходит в партию каждые {{every .Interval}} и жмёт у Мейв
                «призвать пехоту».
            {{else}}
                Выключено. Если включить, воркер будет заходить в партию каждые
                {{every .Interval}} и жать у Мейв «призвать пехоту».
            {{end}}
        </p>
    </div>

    {{if and $t (not $t.LastRunAt.IsZero)}}
        <p class="muted">Последний заход: {{datetime $t.LastRunAt}} — {{$t.LastResult}}</p>
    {{end}}
</div>
{{end}}

{{/* Карта и состав приезжают с игрового сервера, и для своей партии это
     стоит настоящего входа — поэтому там кнопка. Чужую смотрим наблюдателем,
     заходом в партию это не считается, и ждать нажатия незачем. */}}
{{if or .Ours .Game}}
<div class="card">
    <div class="card-head">
        <h1>{{if .Ours}}Что у нас в партии{{else}}Что в партии{{end}}</h1>
        {{if .Ours}}
            <div class="head-actions">
                <a class="button" href="/games/{{.GameID}}?state=1">Заглянуть в партию</a>
            </div>
        {{end}}
    </div>

    {{if .Map}}
        {{/* Карта одна, режимов два: в каждом заливка говорит об одном
             и только одном, поэтому кланы и личные списки не спорят
             за цвет. Переключение — на радиокнопках и css: очертания
             провинций тяжёлые, второй раз выводить их незачем, а скрипт
             ради смены цветов сюда не просится. Порядок важен — правила
             в app.css смотрят от отмеченной кнопки к соседям ниже. */}}
        <div class="map-view">
            <input class="map-mode" type="radio" name="map-mode" id="map-clans" checked>
            <input class="map-mode" type="radio" name="map-mode" id="map-sides">
            <input class="map-mode" type="radio" name="map-mode" id="map-teams">
            <input class="map-mode" type="radio" name="map-mode" id="map-premium">
            <div class="map-tabs">
                <label for="map-clans">Кланы</label>
                <label for="map-sides">Мои списки</label>
                <label for="map-teams">Коалиции</label>
                <label for="map-premium">Премиум</label>
            </div>
            {{/* Карта в собственных координатах игры: viewBox их и берёт,
                 а размер на странице задаёт css. */}}
            <svg class="game-map" viewBox="0 0 {{.Map.Width}} {{.Map.Height}}"
                 preserveAspectRatio="xMidYMid meet" role="img"
                 aria-label="Карта партии: провинции раскрашены по кланам владельцев, по вашим личным спискам, по коалициям или по премиуму">
                <rect width="{{.Map.Width}}" height="{{.Map.Height}}" fill="#16222c"></rect>
                {{range .Map.Shapes}}
                    <polygon points="{{.Points}}" class="{{.Class}}"
                             {{if or .ClanColor .TeamColor}}style="--clan: {{.ClanColor}}; --team: {{.TeamColor}}"{{end}}><title>{{.Title}}</title></polygon>
                {{end}}
                {{/* Подписи поверх заливки: страна пишется один раз, посередине
                     своих владений. */}}
                {{range .Map.Labels}}
                    {{/* Значок отдельным tspan: он красится не как название
                         и в режиме кланов прячется целиком. Ник — второй
                         строкой: перенос в svg не делается сам, поэтому
                         у строки заново задаются x и сдвиг по y. */}}
                    <text x="{{.X}}" y="{{.Y}}" text-anchor="middle"
                          class="{{if .Enemy}}enemy{{else if .Friend}}friend{{end}}">{{if .Mark}}<tspan class="sign">{{.Mark}}</tspan> {{end}}{{.Text}}{{if .Nick}}<tspan class="player" x="{{.X}}" dy="36">{{.Nick}}</tspan>{{end}}</text>
                {{end}}
            </svg>

            <div class="map-pane pane-clans">
                {{/* Легенда обязательна: цвет раздаётся на партию, по убыванию
                     владений, и без подписи не значит ничего. */}}
                {{if .Map.Legend}}
                    <ul class="map-legend">
                        {{range .Map.Legend}}
                            <li>
                                <span class="swatch" style="background: {{if .Color}}{{.Color}}{{else}}#4a5b68{{end}}"></span>
                                {{.Name}}{{if .Tag}} <span class="muted">[{{.Tag}}]</span>{{end}}
                                <span class="muted">— {{.Provinces}}</span>
                            </li>
                        {{end}}
                    </ul>
                    <p class="muted">
                        Цвет провинции — клан её владельца, число в легенде —
                        сколько у клана провинций. Кланы берутся из самой
                        Supremacy, а не из нашего справочника: важно, кто с кем
                        в игре, а не кого мы как записали. Цвета раздаются
                        на партию по убыванию владений, поэтому в соседней партии
                        тот же клан будет другого цвета. Серым закрашены ничейные
                        земли и все, кто ни в каком клане не состоит.
                    </p>
                {{else}}
                    <p class="muted">
                        Карта серая: ни один игрок этой партии в клане
                        не состоит — по крайней мере, так отвечает сайт игры.
                    </p>
                {{end}}
                {{if .AlliancesPending}}
                    {{/* Серый у неспрошенного и у одиночки одинаковый,
                         поэтому про очередь надо сказать словами. */}}
                    <p class="muted">
                        Про {{.AlliancesPending}} игроков этой партии клан ещё
                        не знаем — они пока серые. Обычно кланы приезжают вместе
                        с составом партии, так что это те, кто вошёл в неё совсем
                        недавно; их спросит фоновый воркер, загляните позже.
                    </p>
                {{end}}
            </div>

            <div class="map-pane pane-sides">
                <ul class="map-legend">
                    {{/* Счётчик через with: пустой список — это и нет никого,
                         и «состав партии ещё не смотрели», а обоим случаям
                         подходит просто отсутствие числа. */}}
                    <li><span class="swatch side-enemy"></span> Во врагах{{with .Enemies}} <span class="muted">— {{len .}}</span>{{end}}</li>
                    <li><span class="swatch side-friend"></span> В друзьях{{with .Friends}} <span class="muted">— {{len .}}</span>{{end}}</li>
                </ul>
                <p class="muted">
                    Красным закрашены владения ваших врагов, зелёным — друзей,
                    серым — все остальные; названия их стран подписаны мечом
                    и рукопожатием. Списки личные: сосед видит эту же партию
                    размеченной по-своему.
                </p>
            </div>

            <div class="map-pane pane-teams">
                {{if .Map.Teams}}
                    <ul class="map-legend">
                        {{range .Map.Teams}}
                            <li>
                                <span class="swatch" style="background: {{.Color}}"></span>
                                {{.Name}}{{if .Mine}} <span class="badge">ваша</span>{{end}}
                                <span class="muted">— {{.Members}}</span>
                            </li>
                        {{end}}
                    </ul>
                    <p class="muted">
                        Цвет провинции — коалиция её владельца, число в легенде —
                        сколько в ней игроков этой партии. И коалиции, и цвета
                        к ним берутся из самой игры, а не из нашей базы: она
                        красит себя сама, поэтому цвет здесь тот же, что
                        в клиенте, и верен он на тот момент, когда мы
                        смотрели партию.
                        Серым — все, кто ни в какой коалиции не состоит.
                    </p>
                {{else}}
                    <p class="muted">
                        В этой партии коалиций нет — ни одной живой игра
                        не показала, красить нечего.
                    </p>
                {{end}}
            </div>

            <div class="map-pane pane-premium">
                <ul class="map-legend">
                    <li><span class="swatch premium"></span> С премиумом{{with .Premium}} <span class="muted">— {{len .}}</span>{{end}}</li>
                </ul>
                {{if .Premium}}
                    <p class="muted">
                        Закрашены страны игроков с «Высоким командованием»:
                        {{range $i, $p := .Premium}}{{if $i}}, {{end}}{{$p.Nation}}{{if $p.Name}} ({{$p.Name}}){{end}}{{if $p.Mine}} — это вы{{end}}{{end}}.
                        Подписку игра сообщает про всех участников партии, хотя
                        в самом клиенте чужой премиум ничем не отмечен. Серым —
                        все остальные, включая компьютерных игроков: у них
                        подписки не бывает.
                    </p>
                {{else}}
                    <p class="muted">
                        Карта серая: премиума в этой партии нет ни у кого.
                    </p>
                {{end}}
            </div>

            <p class="muted">
                {{if .Me}}Ваши провинции обведены жёлтым во всех режимах. {{end}}Наведите
                на провинцию, чтобы увидеть, чья она: подсказка говорит всё сразу —
                страну, игрока, клан, премиум и оба ваших списка.
            </p>
        </div>
    {{end}}
    {{if .MapError}}<p class="muted">{{.MapError}}</p>{{end}}

    {{if .State}}
        {{/* Партию сводим с базой по игровому ID: он у карточки и у игрока
             на сайте игры один и тот же. Оба личных списка — списки того,
             кто смотрит, у соседа они свои. */}}
        {{if .Friends}}
            <p class="muted">
                Из ваших друзей здесь играют:
                {{range $i, $f := .Friends}}{{if $i}}, {{end}}<a href="/players/{{$f.Card.ID}}">{{$f.Card.Nickname}}</a>
                    — {{$f.Nation}}{{if $f.Name}} ({{$f.Name}}){{end}}{{if $f.Premium}} <span class="badge">премиум</span>{{end}}{{end}}.
            </p>
        {{else}}
            <p class="muted">Из ваших друзей в этой партии никого.</p>
        {{end}}
        {{if .Enemies}}
            <p class="muted">
                Из вашего списка врагов здесь играют:
                {{range $i, $e := .Enemies}}{{if $i}}, {{end}}<a href="/players/{{$e.Card.ID}}">{{$e.Card.Nickname}}</a>
                    — {{$e.Nation}}{{if $e.Name}} ({{$e.Name}}){{end}}{{if $e.Premium}} <span class="badge">премиум</span>{{end}}{{end}}.
            </p>
        {{else}}
            <p class="muted">Из вашего списка врагов в этой партии никого.</p>
        {{end}}
    {{end}}

    {{if .State}}
        {{/* Премиум игра сообщает про всех участников партии, а в самом
             клиенте чужая подписка ничем не отмечена — значит, показать её
             больше негде. */}}
        {{if .Premium}}
            <p class="muted">
                Премиум («Высокое командование») в этой партии у {{len .Premium}}
                игроков:
                {{range $i, $p := .Premium}}{{if $i}}, {{end}}{{$p.Nation}}{{if $p.Name}} ({{$p.Name}}){{end}}{{if $p.Mine}} — это вы{{end}}{{end}}.
            </p>
        {{else}}
            <p class="muted">Премиума в этой партии нет ни у кого.</p>
        {{end}}
        {{/* Бан — свойство аккаунта, а не партии, поэтому он же уходит
             в базу и потом виден в карточке игрока. */}}
        {{if .Banned}}
            <p class="muted">
                Забанены: {{range $i, $b := .Banned}}{{if $i}}, {{end}}{{$b.Nation}}{{if $b.Name}} ({{$b.Name}}){{end}}{{end}}.
            </p>
        {{end}}
    {{end}}

    {{if .NoProfileGameID}}
        <p class="muted">
            Чтобы видеть на этой странице свою страну, укажите игровой ID
            в <a href="/profile">профиле</a>: по нему вас и находят среди
            игроков партии.
        </p>
    {{end}}
    {{if .NotPlaying}}
        <p class="muted">В этой партии вы не играете — своей страны здесь нет.</p>
    {{end}}

    {{if .Me}}
        <p class="muted">
            День {{.State.Day}}, вы играете за {{.Me.Nation}} ({{.Me.Name}}),
            номер в партии {{.Me.ID}}.
            Провинций под контролем {{len .Mine}} из {{len .State.Provinces}} на карте.
        </p>
        <table>
            <thead>
            <tr>
                <th>Провинция</th>
                <th>Мораль</th>
            </tr>
            </thead>
            <tbody>
            {{range .Mine}}
                <tr>
                    <td>{{.Name}}{{if .Capital}} <span class="badge">столица</span>{{end}}</td>
                    <td class="muted nowrap">{{printf "%.0f" .Morale}}%</td>
                </tr>
            {{end}}
            </tbody>
        </table>
    {{end}}

    {{if not .State}}
        <p class="muted">
            {{if .Ours}}
                Состав партии берётся с игрового сервера, и такой заход игра
                засчитывает как вход в партию — поэтому он делается только по
                нажатию, а не при каждом открытии страницы.
            {{else}}
                Посмотреть партию со стороны не вышло — причина сказана выше.
                Ниже то, что о ней знает сайт игры.
            {{end}}
        </p>
    {{end}}
</div>
{{end}}
{{/* Состав сайт отдаёт про любую партию, не спрашивая, играем ли мы в ней,
     и стоит он дёшево. Показываем его там, где карты нет: до захода в свою
     партию и тогда, когда со стороны посмотреть не удалось. */}}
{{if and .Roster (not .State)}}
<div class="card">
    <h1>Кто играет</h1>
    <p class="muted">
        Состав партии по данным сайта игры: ник, клан, коалиция и уровень.
        Названий у коалиций здесь нет — их знает только игровой сервер,
        поэтому стоит номер: одинаковый номер значит «эти заодно».
        Кого мы знаем, тот подписан ссылкой на карточку.
    </p>
    <table>
        <thead>
        <tr>
            <th>Игрок</th>
            <th>Клан</th>
            <th>Коалиция</th>
            <th>Уровень</th>
        </tr>
        </thead>
        <tbody>
        {{range .Roster}}
            <tr>
                <td>
                    {{if .Card}}
                        <a class="nick" href="/players/{{.Card.ID}}">{{.Login}}</a>
                        {{if .Enemy}}<span class="badge clan-enemy">во врагах</span>{{end}}
                        {{if .Friend}}<span class="badge clan-ally">в друзьях</span>{{end}}
                    {{else}}
                        {{.Login}}
                    {{end}}
                </td>
                <td>{{if .Clan}}{{.Clan}}{{else}}<span class="muted">—</span>{{end}}</td>
                <td class="muted">{{if .Team}}№{{.Team}}{{else}}—{{end}}</td>
                <td class="muted">{{if .Level}}{{.Level}}{{else}}—{{end}}</td>
            </tr>
        {{end}}
        </tbody>
    </table>
</div>
{{end}}

{{end}}
