{{define "title"}}{{t "game.title"}}{{end}}

{{define "content"}}
{{/* Анонимная партия не по зубам пакету — дальше не идёт ничего. Закрыта
     вся страница, а не одна карта: состав с сайта — это те же имена, за
     которыми сюда и приходят, и оставить его значило бы не закрыть ничего.

     Обходить проверку целиком здесь, в разметке, нарочно: данных на такой
     странице просто нет, а забыть спрятать один блок из десяти — вопрос
     времени. */}}
{{if .AnonymousClosed}}
<div class="card">
    <div class="card-head">
        <h1>
            {{t "game.anonymous.title"}}
            <span class="game-id">ID {{.GameID}}</span>
        </h1>
        <div class="head-actions">
            <a class="button ghost" href="/games">{{t "game.all"}}</a>
        </div>
    </div>
    <p class="error">{{t "game.anonymous.closed"}}</p>
    <p class="muted">{{t "game.anonymous.hint"}}</p>
</div>
{{else}}
<div class="card">
    <div class="card-head">
        <h1>
            <span id="game-title">{{template "gametitle" .}}</span>
            <span class="game-id">ID {{.GameID}}</span>
        </h1>
        <div class="head-actions">
            <a class="button ghost" href="/games">{{t "game.all"}}</a>
        </div>
    </div>

    {{if .Error}}<p class="error">{{.Error}}</p>{{end}}

    {{/* Обёртка с id — место, куда запрос состава допишет сведения о чужой
         партии: их называет только сайт, а страница его не дождалась. */}}
    <div id="game-about">{{template "gameabout" .}}</div>
</div>

{{if and .CurrentUser.IsRoot .Ours}}
<div class="card">
    <h1>{{t "game.we"}}</h1>
    {{$t := .Task}}
    <div class="row-form">
        <form method="post" action="/games/{{.GameID}}/hero">
            <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
            <input type="hidden" name="title" value="{{if .Game}}{{.Game.Title}}{{end}}">
            <input type="hidden" name="on" value="{{if and $t $t.HeroDeploy}}0{{else}}1{{end}}">
            <button type="submit">
                {{if and $t $t.HeroDeploy}}{{t "game.hero.off"}}{{else}}{{t "game.hero.on"}}{{end}}
            </button>
        </form>
        {{/* Ручной призыв стоит рядом с переключателем: проверять кнопку,
             дожидаясь тика воркера, невозможно. */}}
        <form method="post" action="/games/{{.GameID}}/hero/run">
            <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
            <button type="submit">{{t "game.hero.now"}}</button>
        </form>
        <p class="muted">
            {{if and $t $t.HeroDeploy}}
                {{t "game.hero.on.note" (everySpan .Interval .IntervalMax)}}
            {{else}}
                {{t "game.hero.off.note" (everySpan .Interval .IntervalMax)}}
            {{end}}
        </p>
    </div>

    {{if and $t (not $t.LastRunAt.IsZero)}}
        <p class="muted">{{t "game.hero.last"}} {{datetime $t.LastRunAt}} — {{$t.LastResult}}</p>
    {{end}}
</div>

{{/* Очередь строительства. Сама очередь лежит в нашей базе и видна всегда,
     а выбор провинции и здания собирается из состояния партии — то есть
     появляется вместе с картой. Правка очереди в партию не ходит, поэтому
     она htmx-ом подменяет только список: карта и форма остаются на месте. */}}
<div class="card">
    <h1>{{t "game.build.title"}}</h1>
    <p class="muted">{{t "game.build.note"}}</p>

    {{if and $t (not $t.BuildRunAt.IsZero)}}
        <p class="muted">
            {{t "game.build.last"}} {{datetime $t.BuildRunAt}} — {{$t.BuildResult}}
            {{if not $t.BuildNextAt.IsZero}}{{t "game.build.next" (datetime $t.BuildNextAt)}}{{end}}
        </p>
    {{end}}

    {{/* Кнопка только при непустой очереди: в пустую воркер не ходит.
         Заход один на обе очереди — и здания, и войска. */}}
    {{if or .BuildQueue .UnitQueue}}
        <form class="row-form" method="post" action="/games/{{.GameID}}/build/now">
            <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
            <button type="submit">{{t "game.build.now"}}</button>
            <span class="muted">{{t "game.build.now.note"}}</span>
        </form>
    {{end}}

    {{if .BuildProvinces}}
        <form class="row-form" method="post" action="/games/{{.GameID}}/build"
              hx-post="/games/{{.GameID}}/build" hx-target="#build-queue" hx-swap="outerHTML">
            <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
            <label>
                {{t "game.build.province"}}
                {{/* Номер и название идут одним полем: страница обновляет
                     после добавления только очередь, а названия нужны ей
                     и без захода в партию. */}}
                <select name="province">
                    {{range .BuildProvinces}}
                        <option value="{{.ID}}|{{.Name}}">{{.Name}}{{if .Now}} — {{t "game.build.busy" .Now (datetime .Ends)}}{{end}}{{if .Queue}} · {{t "game.build.queued" .Queue}}{{end}}</option>
                    {{end}}
                </select>
            </label>
            {{/* Здание выбирается картинкой: в выпадающем списке их не
                 показать. В значении — номер, название и имя картинки. */}}
            <fieldset class="pick-tiles">
                <legend>{{t "game.build.upgrade"}}</legend>
                {{range $i, $u := .BuildUpgrades}}
                    <label class="tile">
                        <input type="radio" name="upgrade" value="{{$u.ID}}|{{$u.Label}}|{{$u.Image}}"{{if eq $i 0}} required{{end}}>
                        {{with upgradeImg $u.Image}}<img src="{{.}}" alt="" loading="lazy">{{end}}
                        <span>{{$u.Label}}</span>
                    </label>
                {{end}}
            </fieldset>
            <button type="submit">{{t "game.build.add"}}</button>
        </form>
    {{else}}
        <p class="muted">{{t "game.build.needmap"}}</p>
    {{end}}

    {{template "buildqueue" .}}
</div>

{{/* Очередь войск — такой же список, но свой слот: производство
     войск в провинции не ждёт стройку. Ходит за ней тот же воркер тем же
     заходом. Что провинция может производить, решает игра, поэтому
     воркер сам скажет в итоге, если нужного здания ещё нет. */}}
<div class="card">
    <h1>{{t "game.units.title"}}</h1>
    <p class="muted">{{t "game.units.note"}}</p>

    {{if .UnitProvinces}}
        <form class="row-form" method="post" action="/games/{{.GameID}}/units"
              hx-post="/games/{{.GameID}}/units" hx-target="#unit-queue" hx-swap="outerHTML">
            <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
            <input type="hidden" name="kind" value="unit">
            <label>
                {{t "game.build.province"}}
                <select name="province">
                    {{range .UnitProvinces}}
                        <option value="{{.ID}}|{{.Name}}">{{.Name}}{{if .Now}} — {{t "game.units.busy" .Now (datetime .Ends)}}{{end}}{{if not .Can}} — {{t "game.units.none"}}{{end}}{{if .Queue}} · {{t "game.build.queued" .Queue}}{{end}}</option>
                    {{end}}
                </select>
            </label>
            <label class="narrow">
                {{t "game.units.count"}}
                <input type="number" name="count" value="1" min="1" max="20" required>
            </label>
            <fieldset class="pick-tiles">
                <legend>{{t "game.units.unit"}}</legend>
                {{range $i, $u := .UnitChoices}}
                    <label class="tile">
                        <input type="radio" name="upgrade" value="{{$u.ID}}|{{$u.Label}}|{{$u.Image}}"{{if eq $i 0}} required{{end}}>
                        {{with unitImg $u.Image}}<img src="{{.}}" alt="" loading="lazy">{{end}}
                        <span>{{$u.Label}}</span>
                    </label>
                {{end}}
            </fieldset>
            <button type="submit">{{t "game.build.add"}}</button>
        </form>
    {{else}}
        <p class="muted">{{t "game.units.needmap"}}</p>
    {{end}}

    {{template "unitqueue" .}}
</div>
{{end}}

{{/* Карта и состав приезжают с игрового сервера, и для своей партии это
     стоит настоящего входа — поэтому там кнопка. Чужую смотрим наблюдателем,
     заходом в партию это не считается, и ждать нажатия незачем. */}}
{{if or .Ours .Game .State}}
<div class="card">
    <div class="card-head">
        <h1>{{if .Ours}}{{t "game.inside.ours"}}{{else}}{{t "game.inside"}}{{end}}</h1>
        {{if .Ours}}
            <div class="head-actions">
                {{/* Класс map-again — метка для таймера: пока срок не вышел,
                     скрипт гасит все такие ссылки. */}}
                <a class="button map-again" href="/games/{{.GameID}}?state=1">{{t "game.enter"}}</a>
            </div>
        {{end}}
    </div>

    {{/* Проверки и возраст данных. Про то, кто именно привёз копию,
         здесь не говорится ни слова: данные о партии общие, и чей это был
         поход — не то, что стоит показывать. */}}
    {{if .ChecksOut}}
        <p class="muted">{{t "game.limit.out"}}</p>
    {{end}}
    {{if .ChecksCounted}}
        <p class="muted">
            {{if .ChecksTotal}}{{t "game.limit.left" .ChecksLeft .ChecksTotal}}{{else}}{{t "game.limit.none"}}{{end}}
        </p>
    {{end}}
    {{/* Метка для скрипта: про возраст копии и срок до новой на странице
         не говорится, но гасить ссылки на это время всё равно нужно —
         нажимать их раньше срока незачем: данные вернутся те же,
         а проверку съедят. Отсюда пустая скрытая метка со сроком.

         Показываем её по готовому тексту таймера: он есть тогда же, когда
         есть и время съёмки, а отсутствующий ключ карты «точки» на метод
         не проверить. */}}
    {{if .MapWaitText}}
        <span class="map-wait" hidden data-wait="{{.MapWait}}"></span>
    {{end}}

    {{if .Map}}{{template "gamemap" .}}{{end}}
    {{if .MapError}}<p class="muted">{{.MapError}}</p>{{end}}

    {{if .State}}
        {{/* Партию сводим с базой по игровому ID: он у карточки и у игрока
             на сайте игры один и тот же. Оба личных списка — списки того,
             кто смотрит, у соседа они свои. */}}
        {{if .Friends}}
            <p class="muted">
                {{t "game.friends.here"}}
                {{range $i, $f := .Friends}}{{if $i}}, {{end}}<a href="/players/{{$f.Card.ID}}">{{$f.Card.Nickname}}</a>
                    — {{$f.Nation}}{{if $f.Name}} ({{$f.Name}}){{end}}{{if $f.Premium}} <span class="badge">{{t "game.premium"}}</span>{{end}}{{end}}.
            </p>
        {{else}}
            <p class="muted">{{t "game.friends.none"}}</p>
        {{end}}
        {{if .Enemies}}
            <p class="muted">
                {{t "game.enemies.here"}}
                {{range $i, $e := .Enemies}}{{if $i}}, {{end}}<a href="/players/{{$e.Card.ID}}">{{$e.Card.Nickname}}</a>
                    — {{$e.Nation}}{{if $e.Name}} ({{$e.Name}}){{end}}{{if $e.Premium}} <span class="badge">{{t "game.premium"}}</span>{{end}}{{end}}.
            </p>
        {{else}}
            <p class="muted">{{t "game.enemies.none"}}</p>
        {{end}}
    {{end}}

    {{if .State}}
        {{/* Премиум игра сообщает про всех участников партии, а в самом
             клиенте чужая подписка ничем не отмечена — значит, показать её
             больше негде. */}}
        {{if .Premium}}
            <p class="muted">
                {{t "game.premium.count" (len .Premium)}}
                {{range $i, $p := .Premium}}{{if $i}}, {{end}}{{$p.Nation}}{{if $p.Name}} ({{$p.Name}}){{end}}{{if $p.Mine}} — {{t "game.thatsyou"}}{{end}}{{end}}.
            </p>
        {{else}}
            <p class="muted">{{t "game.premium.none"}}</p>
        {{end}}
        {{/* Бан — свойство аккаунта, а не партии, поэтому он же уходит
             в базу и потом виден в карточке игрока. */}}
        {{if .Banned}}
            <p class="muted">
                {{t "game.banned"}} {{range $i, $b := .Banned}}{{if $i}}, {{end}}{{$b.Nation}}{{if $b.Name}} ({{$b.Name}}){{end}}{{end}}.
            </p>
        {{end}}
    {{end}}

    {{if .NoProfileGameID}}
        <p class="muted">
            {{t "game.noprofile.pre"}} <a href="/profile">{{t "game.noprofile.link"}}</a>{{t "game.noprofile.post"}}
        </p>
    {{end}}
    {{if .NotPlaying}}
        <p class="muted">{{t "game.notplaying"}}</p>
    {{end}}

    {{/* Список своих провинций с моралью отсюда убран: страница про то,
         кто в партии играет, а не про свои клетки. Сколько их у нас —
         одной строкой. */}}
    {{if .Me}}
        <p class="muted">
            {{t "game.me" .State.Day .Me.Nation .Me.Name .Me.ID}}
            {{t "game.me.provinces" (len .Mine) (len .State.Provinces)}}
        </p>
    {{end}}

    {{/* Кончившиеся проверки — не поломка: про них сказано выше своими
         словами, и жаловаться на молчание игры тут не за что. У своей
         партии состав приезжает по кнопке, и объяснять это словами
         не нужно — кнопка сама рядом. */}}
    {{if and (not .State) (not .Ours) (not .ChecksOut)}}
        <p class="muted">{{t "game.observe.failed"}}</p>
    {{end}}

    {{if .MapWait}}
        <script>
            // Срок до следующей копии страница отсчитывает молча и в конце
            // сама оживляет ссылки: нажатая раньше срока, любая из них
            // вернёт ту же копию, а проверку потратит.
            (function () {
                var box = document.querySelector('.map-wait');
                if (!box) return;
                var left = parseInt(box.dataset.wait, 10) || 0;
                var links = document.querySelectorAll('a.map-again');
                links.forEach(function (a) { a.classList.add('waiting'); });
                var tick = setInterval(function () {
                    left -= 1;
                    if (left > 0) return;
                    clearInterval(tick);
                    links.forEach(function (a) { a.classList.remove('waiting'); });
                }, 1000);
            })();
        </script>
    {{end}}

    {{/* Нажатое «Заглянуть в партию» уводит на новый адрес, и до ответа
         браузер показывает прежнюю страницу. Накрываем её сразу, чтобы
         нажатие не выглядело потерянным: снимать перекрытие не нужно — оно
         уходит вместе со страницей. Возврат «назад» показывает страницу
         из кэша браузера вместе с перекрытием, поэтому там убираем сами. */}}
    <script>
        (function () {
            var box = null;
            document.querySelectorAll('a.map-again').forEach(function (a) {
                a.addEventListener('click', function () {
                    if (a.classList.contains('waiting') || box) return;
                    box = document.createElement('div');
                    box.className = 'page-loading';
                    box.textContent = {{t "game.limit.loading"}};
                    document.body.appendChild(box);
                });
            });
            window.addEventListener('pageshow', function (e) {
                if (!e.persisted || !box) return;
                box.remove();
                box = null;
            });
        })();
    </script>

    {{if .LoaderMs}}
        <script>
            // Сбор данных о партии занимает секунды, и выглядеть он должен
            // одинаково всегда — сколько бы страница ни собиралась на самом
            // деле. Сервер сказал, сколько не хватило до обычного времени;
            // столько и держим карту закрытой.
            (function () {
                var ms = {{.LoaderMs}}, view = document.querySelector('.map-view');
                if (!view || ms <= 0) return;
                var box = document.createElement('div');
                box.className = 'map-loading';
                box.textContent = {{t "game.limit.loading"}};
                view.appendChild(box);
                setTimeout(function () { box.remove(); }, ms);
            })();
        </script>
    {{end}}

    {{if .RosterLater}}
        <script>
            // Состав приезжает, когда человек, может, уже листает режимы
            // карты. Блок карты при этом заменяется целиком, и выбранный
            // режим вернулся бы к первому — запоминаем его и ставим обратно.
            (function () {
                var mode = null;
                document.body.addEventListener('htmx:beforeSwap', function (e) {
                    if (!e.detail.target.classList.contains('map-view')) return;
                    var picked = e.detail.target.querySelector('.map-mode:checked');
                    mode = picked && picked.id;
                });
                document.body.addEventListener('htmx:afterSettle', function () {
                    if (!mode) return;
                    var input = document.getElementById(mode);
                    if (input) input.checked = true;
                    mode = null;
                });
            })();
        </script>
    {{end}}
</div>
{{end}}
{{/* Архив коалиций отвечает на вопрос, которого на карте не видно: эти двое
     уже союзничали раньше? Показываем только пересечения внутри этой партии —
     старые связи посторонних людей здесь никому не нужны. */}}
{{if .State}}
<div class="card">
    <h1>{{t "pairs.title"}}</h1>
    {{if .Pairs}}
        <p class="muted">{{t "pairs.note"}}</p>
        <div class="table-wrap">
            <table>
                <thead>
                <tr>
                    <th>{{t "pairs.who"}}</th>
                    <th class="narrow">{{t "pairs.together"}}</th>
                    <th>{{t "pairs.where"}}</th>
                </tr>
                </thead>
                <tbody>
                {{range .Pairs}}
                    <tr>
                        <td>
                            {{template "pairside" .A}}
                            <span class="muted">—</span>
                            {{template "pairside" .B}}
                        </td>
                        <td class="narrow nowrap muted">
                            {{range $i, $s := .BySpeed}}{{if $i}}, {{end}}{{$s.Label}} — {{$s.Games}}{{end}}
                        </td>
                        <td class="muted">
                            {{range $i, $g := .Games}}{{if $i}}, {{end}}<a href="/games/{{$g}}">{{$g}}</a>{{end}}
                        </td>
                    </tr>
                {{end}}
                </tbody>
            </table>
        </div>
    {{else}}
        <p class="muted">{{t "pairs.empty"}}</p>
    {{end}}
    {{/* Пары, отмеченные админами руками: «играют вместе» из карточек. */}}
    {{if .ManualPairs}}
        <h2>{{t "teammates.game.title"}}</h2>
        <div class="table-wrap">
            <table>
                <tbody>
                {{range .ManualPairs}}
                    <tr>
                        <td>
                            {{template "pairside" .A}}
                            <span class="muted">—</span>
                            {{template "pairside" .B}}
                        </td>
                        <td class="muted">{{.Note}}</td>
                    </tr>
                {{end}}
                </tbody>
            </table>
        </div>
    {{end}}
</div>
{{end}}

{{end}}{{/* AnonymousClosed */}}
{{end}}

{{/* Одна сторона пары: карточка, если она у нас есть, иначе ник из игры. */}}
{{define "pairside"}}{{if .Card}}<a class="nick" href="/players/{{.Card.ID}}">{{.Card.Nickname}}</a>{{else if .Name}}{{.Name}}{{else}}{{t "game.unknown"}}{{end}}<span class="muted"> ({{.Nation}})</span>{{if .Enemy}} <span class="badge clan-enemy">{{t "rel.enemies.markdone"}}</span>{{end}}{{if .Friend}} <span class="badge clan-ally">{{t "rel.friends.markdone"}}</span>{{end}}{{end}}

{{/* Название партии в шапке: у своей оно из списка своих, у чужой — от сайта. */}}
{{define "gametitle"}}{{if .Game}}{{.Game.Title}}{{else}}{{t "game.unnamed" .GameID}}{{end}}{{end}}

{{/* Сведения о партии под шапкой. Отдельным блоком: запрос состава
     дописывает их в страницу чужой партии, которую сайт ещё не назвал. */}}
{{define "gameabout"}}
    {{if .Game}}
        <p class="muted">
            {{t "game.state"}} {{.Game.State}}{{if .Game.Day}}, {{t "game.day" .Game.Day}}{{end}},
            {{t "game.players" .Game.Players}}{{if .Game.Language}}, {{t "game.language" .Game.Language}}{{end}}{{if not .Game.Started.IsZero}},
            {{t "game.startedat"}} {{datetime .Game.Started}}{{end}}{{/* Номер аккаунта проекта — внутренняя кухня,
            и «мы» здесь означает именно его, а не того, кто смотрит. */}}{{if and .CurrentUser.IsRoot .Game.PlayerID}},
            {{t "game.ourplayer" .Game.PlayerID}}{{end}}.
        </p>
    {{end}}
    {{/* Про долгое открытие говорим на самой странице: ждать минуту
         молча — это выглядеть сломанным. */}}
    {{if and .Game .BigGame}}
        <p class="muted">
            {{t "game.big.note"}}
        </p>
    {{end}}
{{end}}

{{/* Состав не приехал: объяснение встаёт на место строки «догружаем».
     Повторить можно, пока действует пропуск — кнопка просит тот же блок. */}}
{{define "rosterfailed"}}
<p class="muted" id="roster-later">
    {{.Message}}
    {{if .Retry}}
        <button type="button"
                hx-get="/games/{{.GameID}}/roster"
                hx-target="closest .map-view" hx-swap="outerHTML">{{t "game.roster.retry"}}</button>
    {{end}}
</p>
{{end}}

{{/* Блок карты со всеми режимами и составом. Отдельным блоком, потому что
     его отдаёт и страница, и запрос состава — тот заменяет карту целиком,
     когда сайт наконец назовёт состав большой партии. */}}
{{/* Список очереди — отдельным блоком: его же отдают в ответ на стрелки
     и крестик, и заменяется он целиком. */}}
{{define "buildqueue"}}{{template "queuelist" (dict "Kind" "building" "ListID" "build-queue" "Groups" .BuildQueue "Error" .BuildError "GameID" .GameID "CSRF" .CSRFToken )}}{{end}}
{{define "unitqueue"}}{{template "queuelist" (dict "Kind" "unit" "ListID" "unit-queue" "Groups" .UnitQueue "Error" .UnitError "GameID" .GameID "CSRF" .CSRFToken )}}{{end}}

{{/* Список очереди одного вида. Стрелки и крестик — обычные формы: без
     htmx они вернут на страницу партии, с ним подменят только этот список.
     Вид уходит с формой, чтобы в ответ пришёл нужный из двух списков. */}}
{{define "queuelist"}}
<div id="{{.ListID}}">
    {{if .Error}}<p class="error">{{.Error}}</p>{{end}}
    {{range .Groups}}
        <h2 class="build-province">{{.Province}}</h2>
        <ol class="build-list">
            {{range .Entries}}
                <li>
                    {{if eq $.Kind "unit"}}
                        {{with unitImg .Image}}<img class="queue-img" src="{{.}}" alt="" loading="lazy">{{end}}
                    {{else}}
                        {{with upgradeImg .Image}}<img class="queue-img" src="{{.}}" alt="" loading="lazy">{{end}}
                    {{end}}
                    <span class="label">{{.Upgrade}}</span>
                    <form method="post" action="/games/{{$.GameID}}/build/{{.ID}}/move"
                          hx-post="/games/{{$.GameID}}/build/{{.ID}}/move"
                          hx-target="#{{$.ListID}}" hx-swap="outerHTML">
                        <input type="hidden" name="csrf_token" value="{{$.CSRF}}">
                        <input type="hidden" name="kind" value="{{$.Kind}}">
                        <input type="hidden" name="dir" value="up">
                        <button class="link" type="submit" title="{{t "game.build.up"}}">↑</button>
                    </form>
                    <form method="post" action="/games/{{$.GameID}}/build/{{.ID}}/move"
                          hx-post="/games/{{$.GameID}}/build/{{.ID}}/move"
                          hx-target="#{{$.ListID}}" hx-swap="outerHTML">
                        <input type="hidden" name="csrf_token" value="{{$.CSRF}}">
                        <input type="hidden" name="kind" value="{{$.Kind}}">
                        <input type="hidden" name="dir" value="down">
                        <button class="link" type="submit" title="{{t "game.build.down"}}">↓</button>
                    </form>
                    <form method="post" action="/games/{{$.GameID}}/build/{{.ID}}/delete"
                          hx-post="/games/{{$.GameID}}/build/{{.ID}}/delete"
                          hx-target="#{{$.ListID}}" hx-swap="outerHTML">
                        <input type="hidden" name="csrf_token" value="{{$.CSRF}}">
                        <input type="hidden" name="kind" value="{{$.Kind}}">
                        <button class="link" type="submit" title="{{t "game.build.remove"}}">×</button>
                    </form>
                </li>
            {{end}}
        </ol>
    {{else}}
        <p class="muted">{{if eq .Kind "unit"}}{{t "game.units.empty"}}{{else}}{{t "game.build.empty"}}{{end}}</p>
    {{end}}
</div>
{{end}}

{{define "gamemap"}}
    {{/* Карта одна, режимов два: в каждом заливка говорит об одном
         и только одном, поэтому альянсы и личные списки не спорят
         за цвет. Переключение — на радиокнопках и css: очертания
         провинций тяжёлые, второй раз выводить их незачем, а скрипт
         ради смены цветов сюда не просится. Порядок важен — правила
         в app.css смотрят от отмеченной кнопки к соседям ниже. */}}
    <div class="map-view">
        <input class="map-mode" type="radio" name="map-mode" id="map-clans" checked>
        <input class="map-mode" type="radio" name="map-mode" id="map-sides">
        <input class="map-mode" type="radio" name="map-mode" id="map-teams">
        <input class="map-mode" type="radio" name="map-mode" id="map-players">
        <input class="map-mode" type="radio" name="map-mode" id="map-power">
        <input class="map-mode" type="radio" name="map-mode" id="map-top">
        {{/* Карта большой партии нарисована без состава с сайта: строка сама
             просит его, как только страница загрузилась, и ответ заменяет
             весь блок карты — уже с составом и кланами от сайта. Стоит после
             радиокнопок: правила css смотрят от них к соседям ниже. */}}
        {{if .RosterLater}}
            <p class="muted" id="roster-later"
               hx-get="/games/{{.GameID}}/roster" hx-trigger="load"
               hx-target="closest .map-view" hx-swap="outerHTML">{{t "game.roster.later"}}</p>
        {{end}}
        <div class="map-tabs">
            <label for="map-clans">{{t "game.map.clans"}}</label>
            <label for="map-sides">{{t "game.map.mine"}}</label>
            <label for="map-teams">{{t "game.map.teams"}}</label>
            <label for="map-players">{{t "game.map.players"}}</label>
            <label for="map-power">{{t "game.map.power"}}</label>
            <label for="map-top">{{t "game.map.top"}}</label>
        </div>
        {{/* Карта в собственных координатах игры: viewBox их и берёт,
             а размер на странице задаёт css. */}}
        <svg class="game-map" viewBox="0 0 {{.Map.Width}} {{.Map.Height}}"
             preserveAspectRatio="xMidYMid meet" role="img"
             aria-label="{{t "game.map.aria"}}">
            <rect width="{{.Map.Width}}" height="{{.Map.Height}}" fill="#16222c"></rect>
            {{range .Map.Shapes}}
                <polygon points="{{.Points}}" class="{{.Class}}"
                         {{if or .ClanColor .TeamColor .TopColor}}style="--clan: {{.ClanColor}}; --team: {{.TeamColor}}; --top: {{.TopColor}}"{{end}}><title>{{.Title}}</title></polygon>
            {{end}}
            {{/* Подписи поверх заливки: страна пишется один раз, посередине
                 своих владений. */}}
            {{range .Map.Labels}}
                {{/* Значок отдельным tspan: он красится не как название
                     и в режиме альянсов прячется целиком. Ник — второй
                     строкой: перенос в svg не делается сам, поэтому
                     у строки заново задаются x и сдвиг по y. */}}
                <text x="{{.X}}" y="{{.Y}}" text-anchor="middle"
                      class="{{if .Enemy}}enemy{{else if .Friend}}friend{{end}}">{{if .Mark}}<tspan class="sign">{{.Mark}}</tspan> {{end}}{{.Text}}{{if .Nick}}<tspan class="player" x="{{.X}}" dy="36">{{.Nick}}</tspan>{{end}}</text>
            {{end}}
        </svg>

        <div class="map-pane pane-clans">
            {{/* Легенда обязательна: цвет раздаётся на партию, по убыванию
                 владений, и без подписи не значит ничего. */}}
            {{if .Map.Legend}}
                <ul class="map-legend">
                    {{range .Map.Legend}}
                        <li>
                            <span class="swatch" style="background: {{if .Color}}{{.Color}}{{else}}#4a5b68{{end}}"></span>
                            {{.Name}}{{if .Tag}} <span class="muted">[{{.Tag}}]</span>{{end}}
                            <span class="muted">— {{.Provinces}}</span>
                        </li>
                    {{end}}
                </ul>
                <p class="muted">
                    {{t "game.map.clans.note"}}
                </p>
            {{else}}
                <p class="muted">
                    {{t "game.map.clans.empty"}}
                </p>
            {{end}}
            {{if .AlliancesPending}}
                {{/* Серый у неспрошенного и у одиночки одинаковый,
                     поэтому про очередь надо сказать словами. */}}
                <p class="muted">
                    {{t "game.map.clans.pending" .AlliancesPending}}
                </p>
            {{end}}
        </div>

        <div class="map-pane pane-sides">
            <ul class="map-legend">
                {{/* Счётчик через with: пустой список — это и нет никого,
                     и «состав партии ещё не смотрели», а обоим случаям
                     подходит просто отсутствие числа. */}}
                <li><span class="swatch side-enemy"></span> {{t "game.map.sides.enemies"}}{{with .Enemies}} <span class="muted">— {{len .}}</span>{{end}}</li>
                <li><span class="swatch side-friend"></span> {{t "game.map.sides.friends"}}{{with .Friends}} <span class="muted">— {{len .}}</span>{{end}}</li>
            </ul>
            <p class="muted">
                {{t "game.map.sides.note"}}
            </p>
        </div>

        <div class="map-pane pane-teams">
            {{if .Map.Teams}}
                <ul class="map-legend">
                    {{range .Map.Teams}}
                        <li>
                            <span class="swatch" style="background: {{.Color}}"></span>
                            {{.Name}}{{if .Mine}} <span class="badge">{{t "game.map.teams.yours"}}</span>{{end}}
                            <span class="muted">— {{.Members}}</span>
                        </li>
                    {{end}}
                </ul>
                <p class="muted">
                    {{t "game.map.teams.note"}}
                </p>
            {{else}}
                <p class="muted">
                    {{t "game.map.teams.empty"}}
                </p>
            {{end}}
        </div>

        <div class="map-pane pane-players">
            {{/* Четыре рода владельцев — четыре цвета, и число рядом
                 с каждым считает людей, а не провинции: цвет здесь
                 говорит про игрока. Ничейная земля остаётся тёмной
                 и в счёт не идёт. */}}
            {{with .Map.Kinds}}
                <ul class="map-legend">
                    <li><span class="swatch human"></span> {{t "game.map.players.regular"}} <span class="muted">— {{.Regular}}</span></li>
                    <li><span class="swatch ai"></span> {{t "game.map.players.ai"}} <span class="muted">— {{.AI}}</span></li>
                    <li><span class="swatch premium"></span> {{t "game.map.premium.legend"}} <span class="muted">— {{.Premium}}</span></li>
                    <li><span class="swatch banned"></span> {{t "game.map.players.banned"}} <span class="muted">— {{.Banned}}</span></li>
                </ul>
            {{end}}
            <p class="muted">
                {{t "game.map.players.note"}}
            </p>
            {{if .Premium}}
                <p class="muted">
                    {{t "game.map.premium.list"}}
                    {{range $i, $p := .Premium}}{{if $i}}, {{end}}{{$p.Nation}}{{if $p.Name}} ({{$p.Name}}){{end}}{{if $p.Mine}} — {{t "game.thatsyou"}}{{end}}{{end}}.
                </p>
            {{end}}
            {{if .Banned}}
                <p class="muted">
                    {{t "game.banned"}}
                    {{range $i, $b := .Banned}}{{if $i}}, {{end}}{{$b.Nation}}{{if $b.Name}} ({{$b.Name}}){{end}}{{end}}.
                </p>
            {{end}}
        </div>

        <div class="map-pane pane-power">
            {{/* Полосы идут от опасных к слабым, как читается взгляд
                 по карте: сначала то, чего стоит бояться. */}}
            {{with .Map.Power}}
                <ul class="map-legend">
                    <li><span class="swatch power-much-up"></span> {{t "game.map.power.muchup"}} <span class="muted">— {{.MuchUp}}</span></li>
                    <li><span class="swatch power-up"></span> {{t "game.map.power.up"}} <span class="muted">— {{.Up}}</span></li>
                    <li><span class="swatch power-even"></span> {{t "game.map.power.even"}} <span class="muted">— {{.Even}}</span></li>
                    <li><span class="swatch power-down"></span> {{t "game.map.power.down"}} <span class="muted">— {{.Down}}</span></li>
                    <li><span class="swatch power-much-down"></span> {{t "game.map.power.muchdown"}} <span class="muted">— {{.MuchDown}}</span></li>
                    <li><span class="swatch"></span> {{t "game.map.power.unknown"}} <span class="muted">— {{.Unknown}}</span></li>
                </ul>
                {{/* Своё число — не украшение: без него «опаснее» и
                     «слабее» не значат ничего. Нет своего счёта — вся
                     карта серая, и сказать об этом надо прямо. */}}
                {{if .Me.Rated}}
                    <p class="muted">{{t "game.map.power.you" .Me.Level (ratio .Me.KD) (ratio .Me.Danger)}}</p>
                {{else if $.NoProfileGameID}}
                    <p class="muted">{{t "game.map.power.noid"}}</p>
                {{else}}
                    <p class="muted">{{t "game.map.power.nostats"}}</p>
                {{end}}
            {{end}}
            <p class="muted">
                {{t "game.map.power.note"}}
            </p>
            {{/* Состав — во вкладке «Сила» и только при карте: до захода
                 в партию таблицы нет, а с картой она отвечает на вопрос
                 этой вкладки словами — кто эти люди и кого из них стоит
                 бояться. Полоса в колонке силы — те же цвета, что выше. */}}
            {{if .Roster}}
                <h2>{{t "game.roster"}}</h2>
                {{/* Без своего боевого счёта колонка силы пуста целиком — сравнивать
                     не с чем. Молчать об этом нельзя: пустой столбец читается как
                     поломка, а не как «нам не с чем сравнивать». */}}
                {{if not .PowerKnown}}<p class="muted">{{t "game.roster.nopower"}}</p>{{end}}

                {{$pages := .RosterPages}}
                <div class="paged">
                    {{if $pages}}
                        {{/* Страницы переключаются радиокнопками и css — как режимы
                             карты. Ходить за ними на сервер нельзя: страница партии
                             перезагружается вместе с показом карты, а тот стоит
                             проверки из дневной квоты.

                             Правила приходится собирать здесь: их ровно столько,
                             сколько страниц, а это число своё у каждой партии. */}}
                        {{range $pages}}<input class="page-pick" type="radio" name="roster-page" id="roster-p{{.}}" {{if eq . 1}}checked{{end}}>{{end}}
                        <style>
                            {{range $pages}}#roster-p{{.}}:checked ~ .table-wrap tr.rpage:not(.rp{{.}}) { display: none; }
                            #roster-p{{.}}:checked ~ .pager label[for="roster-p{{.}}"] { background: var(--accent); color: #fff; }
                            {{end}}
                        </style>
                    {{end}}
                    <div class="table-wrap">
                        {{/* stack: на телефоне десять колонок не помещаются, и строка
                             раскладывается в карточку с подписями из data-label. */}}
                        <table class="roster stack">
                            <thead>
                            <tr>
                                <th>{{t "game.col.player"}}</th>
                                <th>{{t "profile.gameid"}}</th>
                                {{if .State}}<th>{{t "game.col.nation"}}</th>{{end}}
                                <th>{{t "playerform.clan"}}</th>
                                <th>{{t "game.col.team"}}</th>
                                <th>{{t "game.col.level"}}</th>
                                <th>{{t "game.col.kd"}}</th>
                                <th>{{t "game.col.power"}}</th>
                                <th>{{t "game.col.games"}}</th>
                                <th>{{t "game.col.wins"}}</th>
                            </tr>
                            </thead>
                            <tbody>
                            {{$state := .State}}
                            {{range .Roster}}
                                <tr class="{{if .Page}}rpage rp{{.Page}}{{end}}">
                                    <td data-label="{{t "game.col.player"}}">
                                        {{if .Card}}
                                            <a class="nick" href="/players/{{.Card.ID}}">{{.Login}}</a>
                                            {{if .Enemy}}<span class="badge clan-enemy">{{t "rel.enemies.markdone"}}</span>{{end}}
                                            {{if .Friend}}<span class="badge clan-ally">{{t "rel.friends.markdone"}}</span>{{end}}
                                        {{else}}
                                            {{.Login}}
                                        {{end}}
                                    </td>
                                    <td class="muted" data-label="{{t "profile.gameid"}}">{{if .GameID}}<span class="game-id">{{.GameID}}</span>{{else}}—{{end}}</td>
                                    {{if $state}}<td data-label="{{t "game.col.nation"}}">{{if .Nation}}{{.Nation}}{{else}}<span class="muted">—</span>{{end}}</td>{{end}}
                                    <td data-label="{{t "playerform.clan"}}">{{if .Clan}}{{.Clan}}{{else}}<span class="muted">—</span>{{end}}</td>
                                    <td class="muted" data-label="{{t "game.col.team"}}">{{if .Team}}{{t "game.team.no" .Team}}{{else}}—{{end}}</td>
                                    {{/* Уровень берём из состава с сайта: он известен
                                         про каждого участника, в отличие от боевого
                                         счёта, который собирается по мере встреч. */}}
                                    <td class="muted nowrap" data-label="{{t "game.col.level"}}">{{if .Level}}{{.Level}}{{else}}—{{end}}</td>
                                    <td class="muted nowrap" data-label="{{t "game.col.kd"}}">{{if .Stats.Rated}}{{ratio .Stats.KD}}{{else}}—{{end}}</td>
                                    {{/* Полоса — та же, что красит карту: цвет говорит
                                         об отношении к вам, число — об игроке самом. */}}
                                    <td class="muted nowrap" data-label="{{t "game.col.power"}}">
                                        {{if .Stats.Rated}}
                                            {{if .Power}}<span class="swatch {{.Power}}"></span> {{end}}{{ratio .Stats.Danger}}
                                        {{else}}—{{end}}
                                    </td>
                                    <td class="muted nowrap" data-label="{{t "game.col.games"}}">{{if .Stats.Known}}{{.Stats.Games}}{{else}}—{{end}}</td>
                                    <td class="muted nowrap" data-label="{{t "game.col.wins"}}">{{if .Stats.Known}}{{t "game.wins.of" .Stats.SoloWins .Stats.CoalitionWins}}{{else}}—{{end}}</td>
                                </tr>
                            {{end}}
                            </tbody>
                        </table>
                    </div>
                    {{if $pages}}
                        <nav class="pager">
                            {{t "game.roster.page"}}
                            {{range $pages}}<label for="roster-p{{.}}">{{.}}</label>{{end}}
                        </nav>
                    {{end}}
                </div>
            {{end}}
        </div>

        <div class="map-pane pane-top">
            {{/* Три разных пустоты, и путать их нельзя: снимка ещё нет,
                 снимок есть и никого из топа тут нет, и обычный случай
                 с легендой. */}}
            {{/* TopKnown отдельным флагом, а не проверкой времени:
                 на нулевое время шаблон смотреть не умеет — у структуры
                 в {{if}} всегда «истина». */}}
            {{if .Map.Top}}
                <ul class="map-legend">
                    {{range .Map.Top}}
                        <li>
                            <span class="swatch" style="background: {{if .Color}}{{.Color}}{{else}}#4a5b68{{end}}"></span>
                            <b>#{{.Rank}}</b> {{.Name}}{{if .Tag}} <span class="muted">[{{.Tag}}]</span>{{end}}
                            <span class="muted">— {{.Players}} {{t "game.map.top.players"}}, {{.Provinces}} {{t "game.map.top.provinces"}}</span>
                        </li>
                    {{end}}
                </ul>
                <p class="muted">
                    {{t "game.map.top.note"}}
                    {{if .TopKnown}} {{t "game.map.top.at" (datetime .TopAt)}}{{end}}
                </p>
            {{else if .TopKnown}}
                <p class="muted">
                    {{t "game.map.top.empty"}}
                    {{t "game.map.top.at" (datetime .TopAt)}}
                </p>
            {{else}}
                <p class="muted">
                    {{t "game.map.top.none"}}
                </p>
            {{end}}
        </div>

        <p class="muted">
            {{if .Me}}{{t "game.map.yours"}} {{end}}{{t "game.map.hover"}}
        </p>
    </div>
    {{/* Шапку чужой партии запрос состава дописывает тем же ответом: название
         ей называет только сайт. */}}
    {{if .HeadSwap}}
        <span id="game-title" hx-swap-oob="true">{{template "gametitle" .}}</span>
        <div id="game-about" hx-swap-oob="true">{{template "gameabout" .}}</div>
    {{end}}
{{end}}
