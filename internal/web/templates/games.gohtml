{{define "title"}}{{t "games.title"}}{{end}}

{{define "content"}}
{{/* Проверка по номеру доступна всем, кому открыт раздел: сведения
     о партии сайт отдаёт про любую, и заходом в неё это не считается.
     А вот список партий аккаунта — рутовый. */}}
<div class="card">
    <div class="card-head">
        <h1>{{t "games.check"}}</h1>
    </div>
    <form class="row-form" method="get" action="/games/check">
        <input type="text" name="id" value="{{.Query}}" placeholder="{{t "games.check.placeholder"}}"
               autocomplete="off" inputmode="numeric" autofocus>
        <button type="submit">{{t "games.check.submit"}}</button>
    </form>
    {{if .CheckError}}<p class="error">{{.CheckError}}</p>{{end}}
    <p class="muted">
        {{t "games.check.note"}}
    </p>
</div>

{{if .CurrentUser.IsRoot}}
<div class="card">
    <div class="card-head">
        <h1>{{t "games.active"}}</h1>
        <div class="head-actions">
            {{if .PlayURL}}<a class="button" href="{{.PlayURL}}" target="_blank" rel="noopener">{{t "games.open"}}</a>{{end}}
            <a class="button ghost" href="/games">{{t "games.refresh"}}</a>
        </div>
    </div>
    <p class="muted">
        {{t "games.active.note"}}
    </p>

    {{if .Error}}<p class="error">{{.Error}}</p>{{end}}

    {{$root := .CurrentUser.IsRoot}}
    <table>
        <thead>
        <tr>
            <th>{{t "games.col.game"}}</th>
            <th>{{t "games.col.state"}}</th>
            <th>{{t "games.col.day"}}</th>
            <th>{{t "clans.col.players"}}</th>
            <th>{{t "games.col.started"}}</th>
            <th>{{t "games.col.joined"}}</th>
            <th>{{t "games.col.lang"}}</th>
        </tr>
        </thead>
        <tbody>
        {{range .Games}}
            <tr>
                <td>
                    <a class="nick" href="/games/{{.ID}}">{{.Title}}</a>
                    <span class="game-id">ID {{.ID}}</span>
                    {{/* Номер в партии здесь про аккаунт проекта, а не про смотрящего. */}}
                    {{if and $root .PlayerID}}<span class="muted">{{t "games.account.player" .PlayerID}}</span>{{end}}
                </td>
                <td class="nowrap">{{.State}}</td>
                <td>{{.Day}}</td>
                <td>{{.Players}}</td>
                <td class="muted nowrap">{{if .Started.IsZero}}—{{else}}{{datetime .Started}}{{end}}</td>
                <td class="muted nowrap">{{if .Joined.IsZero}}—{{else}}{{datetime .Joined}}{{end}}</td>
                <td class="muted">{{.Language}}</td>
            </tr>
        {{else}}
            <tr>
                <td colspan="7" class="muted">
                    {{if .Error}}{{t "games.list.failed"}}{{else}}{{t "games.list.empty"}}{{end}}
                </td>
            </tr>
        {{end}}
        </tbody>
    </table>
</div>

{{/* Архив коалиций и его рубильник. Обход ходит в игру от общего аккаунта
     проекта, поэтому и кнопка рутовая. */}}
{{with .Coalitions}}
<div class="card">
    <div class="card-head">
        <h1>{{t "coalitions.title"}}</h1>
        <div class="head-actions">
            <form method="post" action="/games/coalitions">
                <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
                <input type="hidden" name="on" value="{{if .On}}0{{else}}1{{end}}">
                <button type="submit" {{if .On}}class="danger"{{end}}>
                    {{if .On}}{{t "coalitions.stop"}}{{else}}{{t "coalitions.start"}}{{end}}
                </button>
            </form>
        </div>
    </div>
    <p class="muted">{{t "coalitions.note"}}</p>
    <p class="muted">
        {{if .On}}{{t "coalitions.on"}}{{else}}{{t "coalitions.off"}}{{end}}
        {{t "coalitions.stats" .Watched .Pending .Games .Members}}
        {{if not .LastCheck.IsZero}}{{t "coalitions.last"}} {{datetime .LastCheck}}.{{end}}
    </p>
</div>
{{end}}
{{end}}
{{end}}
