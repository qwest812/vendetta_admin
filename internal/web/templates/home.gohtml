{{define "title"}}Поиск игроков — Vendetta{{end}}

{{define "content"}}
<div class="card">
    <div class="card-head">
        <h1>Поиск игроков</h1>
        {{if .CurrentUser.IsAdmin}}<a class="button" href="/players/new">Добавить игрока</a>{{end}}
    </div>

    {{/* Фильтр и строка поиска шлют один и тот же запрос, поэтому каждый
         подмешивает значение соседа через hx-include. */}}
    <div class="filters">
        <input type="search" name="q" value="{{.Query}}" placeholder="Игровой ID или ник (можно часть)"
               autofocus autocomplete="off"
               hx-get="/search" hx-trigger="input changed delay:250ms, search"
               hx-include="[name='status']"
               hx-target="#results" hx-swap="innerHTML"
               hx-indicator="#searching">
        <select name="status" class="narrow"
                hx-get="/search" hx-trigger="change"
                hx-include="[name='q']"
                hx-target="#results" hx-swap="innerHTML"
                hx-indicator="#searching">
            <option value="">Все кланы</option>
            <option value="ally" {{if eq .Status "ally"}}selected{{end}}>Только союзные</option>
            <option value="neutral" {{if eq .Status "neutral"}}selected{{end}}>Только нейтральные</option>
            <option value="enemy" {{if eq .Status "enemy"}}selected{{end}}>Только враждебные</option>
        </select>
    </div>
    <p class="muted">
        Всего в базе: {{.Total}}. <span id="searching" class="htmx-indicator">ищем…</span>
    </p>
</div>

<div id="results">{{template "results" .}}</div>
{{end}}
