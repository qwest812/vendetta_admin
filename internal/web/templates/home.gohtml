{{define "title"}}{{t "home.title"}}{{end}}

{{define "content"}}
<div class="card">
    <div class="card-head">
        <h1>{{t "home.heading"}}</h1>
        {{if .CurrentUser.IsAdmin}}<a class="button" href="/players/new">{{t "home.add"}}</a>{{end}}
    </div>

    <div class="filters">
        <input type="search" name="q" value="{{.Query}}" placeholder="{{t "home.search.placeholder"}}"
               autofocus autocomplete="off"
               hx-get="/search" hx-trigger="input changed delay:250ms, search"
               hx-target="#results" hx-swap="innerHTML"
               hx-indicator="#searching">
    </div>

    <p class="muted"><span id="searching" class="htmx-indicator">{{t "home.searching"}}</span></p>
</div>

<div id="results">{{template "results" .}}</div>

{{/* Пометка, упёршаяся в предел пакета, приезжает с кодом 422 и той же
     кнопкой, уже погашенной. htmx на ответы 4xx разметку по умолчанию
     не подменяет — разрешаем ему это здесь: код остаётся честным,
     а человек видит, что кнопка перестала работать, а не гадает.

     Тот же обработчик стоит в «Доступах» — по той же причине и ровно
     такой же. Общего места для него нет намеренно: страниц с htmx
     четыре, и включать подмену 4xx на всех разом значило бы разрешить
     её там, где в ответ на отказ приезжает целая страница. */}}
<script>
    document.body.addEventListener("htmx:beforeSwap", function (e) {
        if (e.detail.xhr.status === 422) {
            e.detail.shouldSwap = true;
            e.detail.isError = false;
        }
    });
</script>
{{end}}
