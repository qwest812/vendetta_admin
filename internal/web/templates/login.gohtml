{{define "title"}}Вход — Vendetta{{end}}

{{define "content"}}
<form class="card login" method="post" action="/login">
    <h1>Vendetta</h1>
    <p class="muted">Вход в базу игроков</p>

    {{if .Error}}<p class="error">{{.Error}}</p>{{end}}

    <label>
        Почта или ник
        <input type="text" name="login" value="{{.Login}}" required autofocus autocomplete="username">
    </label>
    <label>
        Пароль
        <input type="password" name="password" required autocomplete="current-password">
    </label>
    <button type="submit">Войти</button>
</form>
{{end}}
