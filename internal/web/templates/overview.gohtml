{{define "title"}}{{t "ov.title"}}{{end}}

{{/* «Обзор» — главная после входа: что база знает о самом смотрящем.
     Всё собрано само, руками тут ничего не вводится. Каждый блок прячется,
     когда показать нечего, — пустая плашка хуже никакой. */}}
{{define "content"}}
{{/* Первым делом — поиск карты партии: за этим сюда чаще всего и
     приходят. Без доступа к «Играм» карту не открыть, и на том же месте
     стоит поиск игрока. Приветствие — строкой над заголовком. */}}
<section class="ov-hero card">
    <p class="ov-kicker">
        {{t "ov.hello" .CurrentUser.Display}}{{with .Alliance}} · {{.Name}}{{if .Tag}} [{{.Tag}}]{{end}}{{end}}{{with .Stats}} · {{t "ov.level" .Level}}{{end}}
    </p>
    {{if .CurrentUser.CanViewGames}}
        <h1>{{t "ov.find.map"}}</h1>
        <form class="ov-search" method="get" action="/games/check">
            <input type="text" name="id" placeholder="{{t "games.check.placeholder"}}"
                   autocomplete="off" inputmode="numeric" autofocus required>
            <button type="submit">{{t "ov.find.map.go"}}</button>
        </form>
        {{if .Checked}}
            <div class="ov-recent">
                <span class="muted">{{t "ov.recent"}}</span>
                {{range .Checked}}
                    <a class="ov-chip" href="/games/{{.GameID}}" title="{{datetime .CheckedAt}}">{{if .Title}}{{.Title}} · {{end}}<span class="game-id">{{.GameID}}</span></a>
                {{end}}
            </div>
        {{end}}
        {{if .ChecksCounted}}<p class="muted ov-checks">{{t "ov.checks.left" .ChecksLeft .ChecksTotal}} · {{t "ov.find.map.note"}}</p>{{end}}
    {{else}}
        <h1>{{t "ov.find.player"}}</h1>
        <form class="ov-search" method="get" action="/players">
            <input type="search" name="q" placeholder="{{t "home.search.placeholder"}}" autocomplete="off" autofocus required>
            <button type="submit">{{t "ov.find.player.go"}}</button>
        </form>
    {{end}}
</section>

{{if .NoGameID}}
    <div class="card ov-empty">
        <h2>{{t "ov.noid.title"}}</h2>
        <p class="muted">{{t "ov.noid.body"}}</p>
        <a class="button" href="/profile">{{t "ov.noid.cta"}}</a>
    </div>
{{else if not .Stats}}
    <div class="card ov-empty">
        <h2>{{t "ov.nostats.title"}}</h2>
        <p class="muted">{{t "ov.nostats.body"}}</p>
    </div>
{{end}}

{{/* Плитки: число и место среди всех игроков базы со счётом. Полоса —
     та же доля: «сильнее 84% базы» видно и без чтения. */}}
{{with .Stats}}
{{$st := $.Standing}}
<div class="ov-tiles">
    {{template "ov-tile" (dict "Label" (t "ov.tile.level") "Value" .Level "Pct" (index $st "Level") "St" $st)}}
    {{template "ov-tile" (dict "Label" (t "ov.tile.kd") "Value" (ratio .KD) "Pct" (index $st "KD") "St" $st)}}
    {{template "ov-tile" (dict "Label" (t "ov.tile.winrate") "Value" (printf "%d%%" $.WinRate) "Sub" (t "ov.tile.winrate.sub" $.Wins .Games) "Pct" (index $st "WinRate") "St" $st)}}
    {{template "ov-tile" (dict "Label" (t "ov.tile.defeated") "Value" (grouped .Defeated) "Sub" (t "ov.tile.defeated.sub" (grouped .Casualties)) "Pct" (index $st "Defeated") "St" $st)}}
</div>
{{with $st}}<p class="muted ov-note">{{t "ov.tiles.note" (index . "Rated")}}</p>{{end}}
{{end}}

<div class="ov-grid">
    {{/* Союзники — из архива коалиций: с кем чаще всего оказывались
         в одной коалиции. Полоса — доля от самого частого. */}}
    {{if .Allies}}
    <section class="card">
        <div class="card-head"><h2>{{t "ov.allies"}}</h2><span class="muted">{{t "ov.allies.sub"}}</span></div>
        <ul class="ov-bars">
            {{$max := .AlliesMax}}
            {{range .Allies}}
                <li>
                    <span class="ov-bar-label">{{if .CardID}}<a href="/players/{{.CardID}}">{{.Login}}</a>{{else}}{{.Login}}{{end}}</span>
                    <span class="ov-bar"><span style="width: {{barWidth .Games $max}}%"></span></span>
                    <span class="ov-bar-n">{{t "ov.allies.games" .Games}}</span>
                </li>
            {{end}}
        </ul>
    </section>
    {{end}}

    {{with .Alliance}}
    <section class="card">
        <div class="card-head"><h2>{{t "ov.alliance"}}</h2>{{if .Rank}}<span class="badge">{{t "ov.alliance.rank" .Rank}}</span>{{end}}</div>
        <p class="ov-big">{{.Name}}{{if .Tag}} <span class="muted">[{{.Tag}}]</span>{{end}}</p>
        <p class="muted">{{t "ov.alliance.members" .Members}}</p>
    </section>
    {{end}}

    {{/* Партии, где игрок был в коалиции, — из того же архива. */}}
    {{if .Archived}}
    <section class="card ov-wide">
        <div class="card-head"><h2>{{t "ov.archived"}}</h2><span class="muted">{{t "ov.archived.total" .ArchivedTotal}}</span></div>
        <div class="table-wrap">
            <table class="stack">
                <thead><tr>
                    <th>{{t "ov.col.game"}}</th><th>{{t "ov.col.team"}}</th>
                    <th class="narrow">{{t "ov.col.day"}}</th><th class="narrow">{{t "ov.col.state"}}</th>
                </tr></thead>
                <tbody>
                {{range .Archived}}
                    <tr>
                        <td data-label="{{t "ov.col.game"}}">{{if $.CurrentUser.CanViewGames}}<a href="/games/{{.GameID}}">{{if .Title}}{{.Title}}{{else}}{{.GameID}}{{end}}</a>{{else}}{{if .Title}}{{.Title}}{{else}}{{.GameID}}{{end}}{{end}}</td>
                        <td class="muted" data-label="{{t "ov.col.team"}}">{{if .Team}}{{.Team}}{{else}}—{{end}}</td>
                        <td class="narrow" data-label="{{t "ov.col.day"}}">{{if .Day}}{{.Day}}{{else}}—{{end}}</td>
                        <td class="narrow" data-label="{{t "ov.col.state"}}">{{if .Done}}<span class="badge">{{t "ov.state.done"}}</span>{{else}}<span class="badge clan-ally">{{t "ov.state.live"}}</span>{{end}}</td>
                    </tr>
                {{end}}
                </tbody>
            </table>
        </div>
    </section>
    {{end}}

    {{/* Личные списки — врагов и друзей отдельно, свежие сверху. */}}
    {{if .Lists}}
        {{template "ov-listed" (dict "L" .EnemyList "Title" (t "rel.enemies.title") "Path" "/enemies" "Badge" "clan-enemy" "Empty" (t "ov.enemies.none"))}}
        {{template "ov-listed" (dict "L" .FriendList "Title" (t "rel.friends.title") "Path" "/friends" "Badge" "clan-ally" "Empty" (t "ov.friends.none"))}}
    {{end}}
</div>
{{end}}

{{/* Блок личного списка: число в заголовке, первые записи со ссылкой
   на карточку и заметкой, ссылка на весь список. */}}
{{define "ov-listed"}}
<section class="card">
    <div class="card-head">
        <h2>{{.Title}} <span class="badge {{.Badge}}">{{.L.Total}}</span></h2>
        <a class="muted" href="{{.Path}}">{{t "ov.lists.all"}}</a>
    </div>
    {{if .L.Items}}
        <ul class="ov-list">
            {{range .L.Items}}
                <li>
                    <a href="/players/{{.Player.ID}}">{{.Player.Nickname}}</a>
                    <span class="muted ov-note-text">{{if .Comment}}{{.Comment}}{{else if .Player.ClanName}}[{{.Player.ClanName}}]{{end}}</span>
                </li>
            {{end}}
        </ul>
    {{else}}
        <p class="muted">{{.Empty}}</p>
    {{end}}
</section>
{{end}}

{{/* Плитка показателя: подпись, число, строка пояснения и полоса места
   в базе. Без места (счёт есть, а сравнить не с кем) полосы нет. */}}
{{define "ov-tile"}}
<div class="ov-tile">
    <span class="ov-tile-label">{{.Label}}</span>
    <span class="ov-tile-value">{{.Value}}</span>
    {{with .Sub}}<span class="ov-tile-sub">{{.}}</span>{{end}}
    {{if .St}}
        <span class="ov-meter"><span style="width: {{.Pct}}%"></span></span>
        <span class="ov-tile-pct">{{t "ov.tile.pct" .Pct}}</span>
    {{end}}
</div>
{{end}}
