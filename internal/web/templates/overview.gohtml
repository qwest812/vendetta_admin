{{define "title"}}{{t "ov.title"}}{{end}}

{{/* «Обзор» — главная после входа: что база знает о самом смотрящем.
     Всё собрано само, руками тут ничего не вводится. Каждый блок прячется,
     когда показать нечего, — пустая плашка хуже никакой. */}}
{{define "content"}}
{{/* Первым делом — поиск карты партии: за этим сюда чаще всего и
     приходят. Без доступа к «Играм» карту не открыть, и на том же месте
     стоит поиск игрока. Приветствие — строкой над заголовком. */}}
<section class="ov-hero card">
    <p class="ov-kicker">
        {{t "ov.hello" .CurrentUser.Display}}{{with .Alliance}} · {{.Name}}{{if .Tag}} [{{.Tag}}]{{end}}{{end}}{{with .Stats}} · {{t "ov.level" .Level}}{{end}}
    </p>
    {{if .CurrentUser.CanViewGames}}
        <h1>{{t "ov.find.map"}}</h1>
        <form class="ov-search" method="get" action="/games/check">
            <input type="text" name="id" placeholder="{{t "games.check.placeholder"}}"
                   autocomplete="off" inputmode="numeric" autofocus required>
            <button type="submit">{{t "ov.find.map.go"}}</button>
        </form>
        {{if .Checked}}
            <div class="ov-recent">
                <span class="muted">{{t "ov.recent"}}</span>
                {{range .Checked}}
                    <a class="ov-chip" href="/games/{{.GameID}}" title="{{datetime .CheckedAt}}">{{if .Title}}{{.Title}} · {{end}}<span class="game-id">{{.GameID}}</span></a>
                {{end}}
            </div>
        {{end}}
        {{if .ChecksCounted}}<p class="muted ov-checks">{{t "ov.checks.left" .ChecksLeft .ChecksTotal}} · {{t "ov.find.map.note"}}</p>{{end}}
    {{else}}
        <h1>{{t "ov.find.player"}}</h1>
        <form class="ov-search" method="get" action="/players">
            <input type="search" name="q" placeholder="{{t "home.search.placeholder"}}" autocomplete="off" autofocus required>
            <button type="submit">{{t "ov.find.player.go"}}</button>
        </form>
    {{end}}
</section>

{{/* Ваши партии — по снимкам из расширения: мини-карта каждой
     подгружается отдельно, очертания тяжёлые. В игру ради этого никто
     не ходит: снимок присылает клиент, открытый у самого игрока. */}}
{{if .MyGames}}
<h2 class="section-title">{{t "my.title"}}</h2>
{{template "gamecards" (dict "Games" .MyGames "Base" "/overview/map/" "CanGames" .CurrentUser.CanViewGames "Self" true)}}
{{else if .CurrentUser.GameID}}
    <p class="muted my-hint">{{t "my.hint"}}</p>
{{end}}

{{if .NoGameID}}
    <div class="card ov-empty">
        <h2>{{t "ov.noid.title"}}</h2>
        <p class="muted">{{t "ov.noid.body"}}</p>
        <a class="button" href="/profile">{{t "ov.noid.cta"}}</a>
    </div>
{{else if not .Stats}}
    <div class="card ov-empty">
        <h2>{{t "ov.nostats.title"}}</h2>
        <p class="muted">{{t "ov.nostats.body"}}</p>
    </div>
{{end}}

{{with .A}}{{template "analytics" (dict "A" . "Self" true "Games" $.CurrentUser.CanViewGames)}}{{end}}

<div class="ov-grid">
    {{/* Где замечены враги — попутные отметки воркеров: поиск в лобби
         и сбор коалиций. Пусто — тоже ответ, и сказать его стоит. */}}
    {{if .WatchLobby}}
    <section class="card ov-wide">
        <div class="card-head"><h2>{{t "ov.lobby"}}{{with .EnemiesInLobby}} <span class="badge clan-enemy">{{len .}}</span>{{end}}</h2><span class="muted">{{t "ov.lobby.sub"}}</span></div>
        {{if .EnemiesInLobby}}
            <ul class="ov-list">
                {{range .EnemiesInLobby}}
                    <li>
                        <span><a href="/players/{{.CardID}}">{{.Login}}</a>
                            <span class="muted">{{t "ov.lobby.in"}}</span>
                            {{if $.CurrentUser.CanViewGames}}<a href="/games/{{.GameID}}">{{if .Title}}{{.Title}}{{else}}{{.GameID}}{{end}}</a>{{else}}{{if .Title}}{{.Title}}{{else}}{{.GameID}}{{end}}{{end}}</span>
                        <span class="muted">{{t "ov.lobby.since" (ago .SeenAt)}}</span>
                    </li>
                {{end}}
            </ul>
        {{else}}
            <p class="muted">{{t "ov.lobby.none"}}</p>
        {{end}}
    </section>
    {{end}}

    {{/* Личные списки — врагов и друзей отдельно, свежие сверху. */}}
    {{if .Lists}}
        {{template "ov-listed" (dict "L" .EnemyList "Title" (t "rel.enemies.title") "Path" "/enemies" "Badge" "clan-enemy" "Empty" (t "ov.enemies.none"))}}
        {{template "ov-listed" (dict "L" .FriendList "Title" (t "rel.friends.title") "Path" "/friends" "Badge" "clan-ally" "Empty" (t "ov.friends.none"))}}
    {{end}}
</div>
{{end}}

{{/* Блок личного списка: число в заголовке, первые записи со ссылкой
   на карточку и заметкой, ссылка на весь список. */}}
{{define "ov-listed"}}
<section class="card">
    <div class="card-head">
        <h2>{{.Title}} <span class="badge {{.Badge}}">{{.L.Total}}</span></h2>
        <a class="muted" href="{{.Path}}">{{t "ov.lists.all"}}</a>
    </div>
    {{if .L.Items}}
        <ul class="ov-list">
            {{range .L.Items}}
                <li>
                    <a href="/players/{{.Player.ID}}">{{.Player.Nickname}}</a>
                    <span class="muted ov-note-text">{{if .Comment}}{{.Comment}}{{else if .Player.ClanName}}[{{.Player.ClanName}}]{{end}}</span>
                </li>
            {{end}}
        </ul>
    {{else}}
        <p class="muted">{{.Empty}}</p>
    {{end}}
</section>
{{end}}

{{/* Мини-карта своей партии: вы, коалиция, враги, остальные. Ответ
     на запрос из карточки «Ваших партий». */}}
{{define "minimap"}}
{{if .Error}}
    <p class="muted">{{t "my.map.error"}}</p>
{{else}}
    <svg class="mini-map" viewBox="0 0 {{.Width}} {{.Height}}" preserveAspectRatio="xMidYMid meet" role="img" aria-label="{{t "my.title"}}">
        <rect width="{{.Width}}" height="{{.Height}}" fill="#16222c"></rect>
        {{range .Shapes}}<polygon points="{{.Points}}" class="{{.Class}}"></polygon>{{end}}
    </svg>
    <ul class="map-legend mini-legend">
        <li><span class="swatch mm-me"></span> {{if .Who}}{{.Who}}{{else}}{{t "my.me"}}{{end}}</li>
        {{with index .Counts "mm-team"}}<li><span class="swatch mm-team"></span> {{t "my.legend.team"}} <span class="muted">— {{.}}</span></li>{{end}}
        {{with index .Counts "mm-enemy"}}<li><span class="swatch mm-enemy"></span> {{t "my.legend.enemies"}} <span class="muted">— {{.}}</span></li>{{end}}
        <li><span class="swatch mm-human"></span> {{t "my.legend.others"}}</li>
        {{if .Scanned}}
            <li><span class="swatch mm-free"></span> {{t "my.legend.freebots"}}</li>
        {{else}}
            <li><span class="swatch mm-ai"></span> {{t "my.legend.bots"}}</li>
        {{end}}
    </ul>
{{end}}
{{end}}
