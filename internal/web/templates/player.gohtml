{{define "title"}}{{.Player.Nickname}} — Vendetta{{end}}

{{define "content"}}
{{$p := .Player}}
<div class="card">
    <div class="card-head">
        <div>
            <h1 class="nick-big">{{$p.Nickname}}</h1>
            {{if $p.ClanName}}
                <a class="clan clan-{{$p.ClanStatus}}" href="/clans/{{$p.ClanID}}">[{{$p.ClanName}}]</a>
                {{if $p.ClanStatus.Marked}}
                    <span class="badge clan-{{$p.ClanStatus}}">{{t "player.clan.status" (clanStatus $p.ClanStatus)}}</span>
                {{end}}
            {{end}}
            {{if $p.GameID}}
                <span class="game-id">ID {{$p.GameID}}</span>
            {{else}}
                <span class="muted">{{t "player.noid"}}</span>
            {{end}}
            {{/* Что игра рассказала про этого человека при последнем заходе
                 в партию с ним. Бан — свойство аккаунта, поэтому ему тут
                 самое место. */}}
            {{with .Seen}}
                {{if .Banned}}
                    <span class="badge clan-enemy">{{t "player.banned"}}</span>
                {{end}}
            {{end}}
        </div>
        {{if .CurrentUser.IsAdmin}}
            <div class="head-actions">
                <a class="button" href="/players/{{$p.ID}}/edit">{{t "common.edit"}}</a>
                {{if .CurrentUser.IsRoot}}
                    <form method="post" action="/players/{{$p.ID}}/delete"
                          onsubmit="return confirm('{{t "player.delete.confirm" $p.Nickname}}')">
                        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
                        <button class="danger" type="submit">{{t "common.delete"}}</button>
                    </form>
                {{end}}
            </div>
        {{end}}
    </div>

    {{/* Метки со счётчиком: одна отметка и пять отметок — разные вещи.
         Имена отметивших подсказкой видят только админы. */}}
    {{if .Marks}}
        <div class="trait-list">
            {{range .Marks}}
                <span class="tag {{if .IsNegative}}neg{{else if .IsPositive}}pos{{else}}zero{{end}}"
                      {{if $.CurrentUser.IsAdmin}}title="{{t "player.traits.by" (join .By)}}"{{end}}>{{.Name}} · {{.Count}}</span>
            {{end}}
        </div>
    {{else}}
        <p class="muted">{{t "player.notraits"}}</p>
    {{end}}

    {{/* Что игра рассказала про игрока сама. Появляется только у тех,
         кого мы встретили в партии: связь идёт по игровому ID.

         Ник и бан — про самого человека, их видят все. А когда и в какой
         партии его встретили — след наших собственных заходов в игру,
         и он открыт с расширенного пакета. */}}
    {{with .Seen}}
        <p class="muted">
            {{t "player.seen.ingame"}}{{if .Nickname}} {{t "player.seen.as" .Nickname}}{{end}};
            {{if .Banned}}{{t "player.seen.banned"}}{{with .BannedAt}} — {{t "player.seen.noticed"}} {{datetime .}}{{end}}{{else}}{{t "player.seen.notbanned"}}{{end}}.
            {{if $.CurrentUser.CanSeeLastSeen}}
                {{t "player.seen.at"}} {{datetime .SeenAt}}{{if .SeenGameID}} {{t "player.seen.ingamepre"}} <a href="/games/{{.SeenGameID}}">{{t "player.seen.game" .SeenGameID}}</a>{{end}}.
            {{end}}
        </p>
    {{end}}

    {{/* Боевой счёт с сайта игры. Считает его страница партии, здесь он
         только показан; у неспрошенного строки нет вовсе — нули соврали бы
         про человека, которого мы просто не спрашивали. */}}
    {{with .Stats}}
        {{if .Rated}}
            <p class="muted">
                {{t "player.stats"}} {{t "player.stats.level" .Level}}, {{t "player.stats.kd" (ratio .KD)}};
                {{t "player.stats.games" .Games}}{{if .SoloWins}}, {{t "player.stats.solo" .SoloWins}}{{end}}{{if .CoalitionWins}}, {{t "player.stats.coalition" .CoalitionWins}}{{end}}.
            </p>
        {{end}}
    {{end}}

    {{/* История банов. Строка выше говорит только про сегодня, и снятый
         бан из неё исчезает бесследно, — а здесь остаётся. */}}
    {{with .Bans}}
        <p class="muted">{{t "player.bans.title"}} — {{t "player.bans.hint"}}.</p>
        <ul class="bans">
            {{range .}}
                <li>
                    <span>{{datetime .NoticedAt}}</span>
                    {{if .Banned}}
                        <span class="badge clan-enemy">{{t "player.bans.banned"}}</span>
                    {{else}}
                        <span class="badge clan-ally">{{t "player.bans.lifted"}}</span>
                    {{end}}
                    {{if .GameID}}
                        <span>{{t "player.seen.ingamepre"}} <a href="/games/{{.GameID}}">{{t "player.seen.game" .GameID}}</a></span>
                    {{end}}
                </li>
            {{end}}
        </ul>
    {{end}}
    <p class="muted">{{t "player.added"}} {{datetime $p.CreatedAt}}, {{t "player.changed"}} {{datetime $p.UpdatedAt}}</p>
</div>

{{/* Признаки и герои свёрнуты: отмечают их изредка, а читают карточку
     каждый раз — списки на два экрана мешали бы добраться до комментариев.
     Что отмечено, видно и в закрытом виде: метки стоят в шапке карточки,
     а число — в самом заголовке. */}}
<details class="card fold">
    <summary>
        <span class="fold-title">{{t "player.traits"}}</span>
        <span class="muted">{{if .Marks}}{{t "player.fold.marked" (len .Marks)}}{{else}}{{t "player.fold.none"}}{{end}}</span>
    </summary>

    {{/* Галочки личные: правят только мои отметки, чужие не трогают.
         Отмечать может любой, у кого есть доступ, — замечает поведение
         тот, кто играет рядом. */}}
    <form method="post" action="/players/{{$p.ID}}/traits" class="note-form">
        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
        {{if .Traits}}
            {{$marked := .Marked}}
            <div class="trait-checks">
                {{range .Traits}}
                    <label class="check {{if .IsNegative}}neg{{else if .IsPositive}}pos{{else}}zero{{end}}">
                        <input type="checkbox" name="traits" value="{{.ID}}" {{if index $marked .ID}}checked{{end}}>
                        <span>{{.Name}}</span>
                    </label>
                {{end}}
            </div>
        {{end}}
        <button type="submit">{{t "player.traits.save"}}</button>
        <p class="muted">{{t "player.traits.hint"}}</p>
    </form>

    {{/* Кто отметил — видно админам, им же доступно снятие признака
         у всех разом: средство против наговора. */}}
    {{if and .Marks .CurrentUser.IsAdmin}}
        {{$csrf := .CSRFToken}}
        <ul class="trait-marks">
            {{range .Marks}}
                <li>
                    <span class="tag {{if .IsNegative}}neg{{else if .IsPositive}}pos{{else}}zero{{end}}">{{.Name}} · {{.Count}}</span>
                    <span class="muted">{{t "player.traits.by" (join .By)}}</span>
                    <form method="post" action="/players/{{$p.ID}}/traits/{{.ID}}/dropall"
                          onsubmit="return confirm('{{t "player.traits.dropall.confirm" .Name .Count}}')">
                        <input type="hidden" name="csrf_token" value="{{$csrf}}">
                        <button class="link" type="submit">{{t "player.traits.dropall"}}</button>
                    </form>
                </li>
            {{end}}
        </ul>
    {{end}}
</details>

{{/* Герои: показываются все, у неотмеченных выбран ноль — «героя нет».
     Ряд переключателей у каждого своей длины: ступеней у героев
     от десяти до двадцати. */}}
{{with .Heroes}}
<details class="card fold">
    <summary>
        <span class="fold-title">{{t "player.heroes"}}</span>
        <span class="muted">{{if $.HeroesMarked}}{{t "player.fold.marked" $.HeroesMarked}}{{else}}{{t "player.fold.none"}}{{end}}</span>
    </summary>
    <form method="post" action="/players/{{$p.ID}}/heroes" class="note-form">
        <input type="hidden" name="csrf_token" value="{{$.CSRFToken}}">
        <ul class="hero-rows">
            {{range .}}
                <li>
                    <div class="hero-who">
                        <img class="hero-face" src="/heroes/img/{{.Image}}" alt="" width="32" height="41" loading="lazy">
                        <div>
                            <b>{{.Name}}</b>
                            {{if .Count}}
                                <span class="kv muted">{{t "player.hero.level" .Level}} · {{.Count}}</span>
                            {{end}}
                            <div class="muted">{{.Subtitle}}</div>
                        </div>
                    </div>
                    {{$mine := .Mine}}{{$field := printf "hero-%d" .UnitTypeID}}
                    {{if .Max}}
                        <div class="hero-levels">
                            {{range .Levels}}
                                <label class="lvl {{if eq . 0}}zero{{end}}">
                                    <input type="radio" name="{{$field}}" value="{{.}}" {{if eq . $mine}}checked{{end}}>
                                    <span>{{.}}</span>
                                </label>
                            {{end}}
                        </div>
                    {{else}}
                        <span class="muted">{{t "player.hero.nolevels"}}</span>
                    {{end}}
                </li>
            {{end}}
        </ul>
        <button type="submit">{{t "player.heroes.save"}}</button>
        <p class="muted">{{t "player.heroes.hint"}}</p>
    </form>
</details>
{{end}}

<div class="card">
    <h1>{{t "player.comments"}}</h1>
    {{if .Error}}<p class="error">{{.Error}}</p>{{end}}

    {{/* Комментарий у каждого один: новый текст заменяет прежний. Про это
         предупреждает и подпись, и вопрос перед отправкой — чтобы замена
         не оказалась неожиданностью. */}}
    <form method="post" action="/players/{{$p.ID}}/comments" class="note-form"
          {{if .MyComment}}onsubmit="return confirm('{{t "player.comment.replace.confirm"}}')"{{end}}>
        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
        <textarea name="body" rows="3" maxlength="{{.CommentMax}}"
                  placeholder="{{t "player.comment.placeholder"}}">{{.Body}}</textarea>
        <button type="submit">{{if .MyComment}}{{t "player.comment.update"}}{{else}}{{t "player.comment.add"}}{{end}}</button>
        <p class="muted">{{t "player.comment.hint" .CommentMax}}</p>
    </form>

    {{$me := .CurrentUser}}
    {{$csrf := .CSRFToken}}
    <ul class="notes">
        {{range .Comments}}
            <li>
                <div class="note-head">
                    {{/* Лента анонимна: имя показывается админам, остальные
                         видят только дату. Свой комментарий подписан всегда —
                         иначе его не найти среди чужих. */}}
                    {{if $me.IsAdmin}}
                        <span class="author">{{if .AuthorName}}{{.AuthorName}}{{else}}{{t "player.comment.gone"}}{{end}}</span>
                    {{else if .Mine $me}}
                        <span class="author">{{t "player.comment.mine"}}</span>
                    {{end}}
                    <span class="muted">{{datetime .UpdatedAt}}{{if .Edited}} · {{t "player.comment.edited"}}{{end}}</span>
                    {{if .CanDelete $me}}
                        <form method="post" action="/comments/{{.ID}}/delete"
                              onsubmit="return confirm('{{t "player.comment.delete.confirm"}}')">
                            <input type="hidden" name="csrf_token" value="{{$csrf}}">
                            <button class="link" type="submit">{{t "common.delete.lower"}}</button>
                        </form>
                    {{end}}
                </div>
                <p class="note-body">{{.Body}}</p>
            </li>
        {{else}}
            <li class="muted">{{t "player.comments.empty"}}</li>
        {{end}}
    </ul>
</div>
{{end}}
