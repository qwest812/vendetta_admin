{{define "title"}}{{.Player.Nickname}} — Vendetta{{end}}

{{define "content"}}
{{$p := .Player}}
<div class="card">
    <div class="card-head">
        <div>
            <h1 class="nick-big">{{$p.Nickname}}</h1>
            {{if $p.ClanName}}
                <a class="clan clan-{{$p.ClanStatus}}" href="/clans/{{$p.ClanID}}">[{{$p.ClanName}}]</a>
                {{if $p.ClanStatus.Marked}}
                    <span class="badge clan-{{$p.ClanStatus}}">{{t "player.clan.status" (clanStatus $p.ClanStatus)}}</span>
                {{end}}
            {{end}}
            {{if $p.GameID}}
                <span class="game-id">ID {{$p.GameID}}</span>
            {{else}}
                <span class="muted">{{t "player.noid"}}</span>
            {{end}}
            {{/* Что игра рассказала про этого человека при последнем заходе
                 в партию с ним. Бан — свойство аккаунта, поэтому ему тут
                 самое место. */}}
            {{with .Seen}}
                {{if .Banned}}
                    <span class="badge clan-enemy">{{t "player.banned"}}</span>
                {{end}}
            {{end}}
        </div>
        {{if .CurrentUser.IsAdmin}}
            <div class="head-actions">
                <a class="button" href="/players/{{$p.ID}}/edit">{{t "common.edit"}}</a>
                {{if .CurrentUser.IsRoot}}
                    <form method="post" action="/players/{{$p.ID}}/delete"
                          onsubmit="return confirm('{{t "player.delete.confirm" $p.Nickname}}')">
                        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
                        <button class="danger" type="submit">{{t "common.delete"}}</button>
                    </form>
                {{end}}
            </div>
        {{end}}
    </div>

    {{if $p.Traits}}
        <div class="trait-list">
            {{range $p.Traits}}
                <span class="tag {{if .IsNegative}}neg{{else if .IsPositive}}pos{{else}}zero{{end}}">{{.Name}}</span>
            {{end}}
        </div>
    {{else}}
        <p class="muted">{{t "player.notraits"}}</p>
    {{end}}

    {{/* Что игра рассказала про игрока сама. Появляется только у тех,
         кого мы встретили в партии: связь идёт по игровому ID. */}}
    {{with .Seen}}
        <p class="muted">
            {{t "player.seen.ingame"}}{{if .Nickname}} {{t "player.seen.as" .Nickname}}{{end}};
            {{if .Banned}}{{t "player.seen.banned"}}{{with .BannedAt}} — {{t "player.seen.noticed"}} {{datetime .}}{{end}}{{else}}{{t "player.seen.notbanned"}}{{end}}.
            {{t "player.seen.at"}} {{datetime .SeenAt}}{{if .SeenGameID}} {{t "player.seen.ingamepre"}} <a href="/games/{{.SeenGameID}}">{{t "player.seen.game" .SeenGameID}}</a>{{end}}.
        </p>
    {{end}}

    {{/* Боевой счёт с сайта игры. Считает его страница партии, здесь он
         только показан; у неспрошенного строки нет вовсе — нули соврали бы
         про человека, которого мы просто не спрашивали. */}}
    {{with .Stats}}
        {{if .Rated}}
            <p class="muted">
                {{t "player.stats"}} {{t "player.stats.level" .Level}}, {{t "player.stats.kd" (ratio .KD)}};
                {{t "player.stats.games" .Games}}{{if .SoloWins}}, {{t "player.stats.solo" .SoloWins}}{{end}}{{if .CoalitionWins}}, {{t "player.stats.coalition" .CoalitionWins}}{{end}}.
            </p>
        {{end}}
    {{end}}

    {{/* История банов. Строка выше говорит только про сегодня, и снятый
         бан из неё исчезает бесследно, — а здесь остаётся. */}}
    {{with .Bans}}
        <p class="muted">{{t "player.bans.title"}} — {{t "player.bans.hint"}}.</p>
        <ul class="bans">
            {{range .}}
                <li>
                    <span>{{datetime .NoticedAt}}</span>
                    {{if .Banned}}
                        <span class="badge clan-enemy">{{t "player.bans.banned"}}</span>
                    {{else}}
                        <span class="badge clan-ally">{{t "player.bans.lifted"}}</span>
                    {{end}}
                    {{if .GameID}}
                        <span>{{t "player.seen.ingamepre"}} <a href="/games/{{.GameID}}">{{t "player.seen.game" .GameID}}</a></span>
                    {{end}}
                </li>
            {{end}}
        </ul>
    {{end}}
    <p class="muted">{{t "player.added"}} {{datetime $p.CreatedAt}}, {{t "player.changed"}} {{datetime $p.UpdatedAt}}</p>
</div>

<div class="card">
    <h1>{{t "player.notes"}}</h1>
    {{if .Error}}<p class="error">{{.Error}}</p>{{end}}

    {{/* Признаки отмечаются вместе с комментарием: замечают поведение
         и пишут о нём в один заход, одной кнопкой. Текст при этом
         необязателен — можно отправить одни галочки. */}}
    <form method="post" action="/players/{{$p.ID}}/notes" class="note-form">
        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
        <textarea name="body" rows="3" placeholder="{{t "player.note.placeholder"}}">{{.Body}}</textarea>
        {{if .Traits}}
            {{$marked := .Marked}}
            <div class="trait-checks">
                {{range .Traits}}
                    <label class="check {{if .IsNegative}}neg{{else if .IsPositive}}pos{{else}}zero{{end}}">
                        <input type="checkbox" name="traits" value="{{.ID}}" {{if index $marked .ID}}checked{{end}}>
                        <span>{{.Name}}</span>
                    </label>
                {{end}}
            </div>
        {{end}}
        <button type="submit">{{t "player.note.add"}}</button>
        <p class="muted">{{t "player.note.hint"}}</p>
    </form>

    {{$me := .CurrentUser}}
    {{$csrf := .CSRFToken}}
    <ul class="notes">
        {{range .Notes}}
            <li>
                <div class="note-head">
                    <span class="author">{{.AuthorEmail}}</span>
                    <span class="muted">{{datetime .CreatedAt}}</span>
                    {{if .CanDelete $me}}
                        <form method="post" action="/notes/{{.ID}}/delete"
                              onsubmit="return confirm('{{t "player.note.delete.confirm"}}')">
                            <input type="hidden" name="csrf_token" value="{{$csrf}}">
                            <button class="link" type="submit">{{t "common.delete.lower"}}</button>
                        </form>
                    {{end}}
                </div>
                <p class="note-body">{{.Body}}</p>
            </li>
        {{else}}
            <li class="muted">{{t "player.notes.empty"}}</li>
        {{end}}
    </ul>
</div>
{{end}}

{{/* Признаки игрока: отмеченные метками и весь справочник переключателями.
     Блок отдаётся целиком и на нажатие тоже — метки и переключатели должны
     сходиться, а одно нажатие меняет обе половины. */}}
