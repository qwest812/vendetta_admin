{{define "title"}}{{if .Player}}{{t "playerform.edit"}}{{else}}{{t "playerform.new"}}{{end}} — Vendetta{{end}}

{{define "content"}}
<div class="card">
    <h1>{{if .Player}}{{t "playerform.edit"}}{{else}}{{t "playerform.new"}}{{end}}</h1>
    {{if .Error}}<p class="error">{{.Error}}</p>{{end}}

    <form method="post" action="{{if .Player}}/players/{{.Player.ID}}{{else}}/players{{end}}">
        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">

        <div class="row-form">
            <label>
                {{t "profile.gameid"}}
                <input name="game_id" value="{{if .Player}}{{.Player.GameID}}{{end}}"
                       maxlength="32" required {{if not .Player}}autofocus{{end}} autocomplete="off">
            </label>
            <label>
                {{t "profile.nick"}}
                <input name="nickname" value="{{if .Player}}{{.Player.Nickname}}{{end}}"
                       maxlength="64" required {{if .Player}}autofocus{{end}} autocomplete="off">
            </label>
            <label>
                {{t "playerform.clan"}}
                <input name="clan" value="{{if .Player}}{{.Player.ClanName}}{{end}}"
                       list="clans" placeholder="{{t "playerform.clan.placeholder"}}" autocomplete="off">
                <datalist id="clans">
                    {{range .Clans}}<option value="{{.Name}}">{{end}}
                </datalist>
            </label>
        </div>

        {{if not .Player}}
            <label class="block">
                {{t "playerform.firstnote"}} <span class="muted">{{t "common.optional"}}</span>
                <textarea name="note" rows="3" placeholder="{{t "playerform.firstnote.placeholder"}}"></textarea>
            </label>
        {{end}}

        <div class="form-actions">
            <button type="submit">{{t "common.save"}}</button>
            <a class="button ghost" href="{{if .Player}}/players/{{.Player.ID}}{{else}}/{{end}}">{{t "common.cancel"}}</a>
        </div>
    </form>
</div>
{{end}}
