{{define "title"}}{{t "profile.title"}}{{end}}

{{define "content"}}
{{$p := .Profile}}
<div class="card">
    <div class="card-head">
        <h1>{{t "profile.heading"}}</h1>
        <div class="head-actions">
            {{/* Роль и пакет рядом, но говорят о разном: роль — кем человек
                 вправе управлять, пакет — сколько можно ему самому. */}}
            <span class="badge role-{{$p.Role}}">{{role $p.Role}}</span>
            <span class="badge">{{t "profile.plan"}}: {{plan $p.Plan}}</span>
        </div>
    </div>

    {{if .Error}}<p class="error">{{.Error}}</p>{{end}}
    {{if .Notice}}<p class="muted">{{.Notice}}</p>{{end}}

    <p class="muted">
        {{t "profile.nick"}} <b>{{$p.Nickname}}</b>{{if $p.Email}}, {{t "profile.email"}} {{$p.Email}}{{end}}.
        {{t "profile.note"}}
    </p>

    {{/* Что даёт пакет. Пишем здесь, а не только в «Доступах»: человек
         упирается в предел у себя, а раздел с пакетами видит один рут. */}}
    <p class="muted">
        {{$limit := $p.RelationLimit}}
        {{if $limit}}{{t "profile.plan.limit" $limit}}{{else}}{{t "profile.plan.free"}}{{end}}
    </p>

    <form method="post" action="/profile">
        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
        <div class="row-form">
            <label>
                {{t "profile.fullname"}}
                <input type="text" name="full_name" value="{{$p.FullName}}" maxlength="100" autocomplete="name">
            </label>
            <label>
                {{t "profile.city"}}
                <input type="text" name="city" value="{{$p.City}}" maxlength="100" autocomplete="address-level2">
            </label>
            <label>
                {{t "profile.gameid"}}
                <input type="text" name="game_id" value="{{$p.GameID}}" maxlength="32" autocomplete="off"
                       placeholder="{{t "profile.gameid.placeholder"}}">
            </label>
            <button type="submit">{{t "common.save"}}</button>
        </div>
    </form>
</div>
{{end}}
