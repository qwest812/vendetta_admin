{{define "title"}}{{t "traits.title"}}{{end}}

{{define "content"}}
<div class="card">
    <h1>{{t "traits.how"}}</h1>
    <p class="muted">
        {{t "traits.how.1"}}
        {{t "traits.how.2"}} <b>{{.RiskMax}}</b> {{t "traits.how.forrisk"}} <b>{{.LoyaltyMax}}</b> {{t "traits.how.forloyalty"}}
        {{t "traits.how.3"}}
    </p>
</div>

<div class="card">
    <h1>{{t "traits.new"}}</h1>
    {{if .Error}}<p class="error">{{.Error}}</p>{{end}}
    <form class="row-form" method="post" action="/traits">
        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
        <label>
            {{t "traits.col.code"}}
            <input name="code" placeholder="uses_cheats" pattern="[a-z][a-z0-9_]{1,39}" required autocomplete="off">
        </label>
        <label>
            {{t "common.name"}}
            <input name="name" placeholder="{{t "traits.name.placeholder"}}" maxlength="80" required autocomplete="off">
        </label>
        <label class="narrow">
            {{t "traits.col.weight"}}
            <input type="number" name="weight" value="0" min="-100" max="100" required>
        </label>
        <label class="narrow">
            {{t "traits.col.order"}}
            <input type="number" name="sort_order" value="100" min="0" max="9999">
        </label>
        <button type="submit">{{t "common.add"}}</button>
    </form>
    <p class="muted">{{t "traits.code.note"}}</p>
</div>

<div class="card">
    <h1>{{t "common.directory"}}</h1>
    {{$canDelete := .CurrentUser.IsAdmin}}
    {{$csrf := .CSRFToken}}
    {{$usage := .Usage}}
    <table>
        <thead>
        <tr>
            <th>{{t "traits.col.code"}}</th>
            <th>{{t "common.name"}}</th>
            <th class="narrow">{{t "traits.col.weight"}}</th>
            <th class="narrow">{{t "traits.col.order"}}</th>
            <th class="narrow">{{t "traits.col.active"}}</th>
            <th class="narrow">{{t "traits.col.used"}}</th>
            <th class="actions">{{t "common.actions"}}</th>
        </tr>
        </thead>
        <tbody>
        {{range .Traits}}
            {{/* Формы вынесены за таблицу: <form> нельзя размещать внутри <tr>,
                 поэтому поля связаны с ней атрибутом form. */}}
            <tr class="{{if not .IsActive}}inactive{{end}}">
                <td><code>{{.Code}}</code></td>
                <td><input form="trait-{{.ID}}" name="name" value="{{.Name}}" maxlength="80" required></td>
                <td class="narrow"><input form="trait-{{.ID}}" type="number" name="weight" value="{{.Weight}}" min="-100" max="100" required></td>
                <td class="narrow"><input form="trait-{{.ID}}" type="number" name="sort_order" value="{{.SortOrder}}" min="0" max="9999"></td>
                <td class="narrow">
                    <input form="trait-{{.ID}}" type="hidden" name="is_active" value="false">
                    <input form="trait-{{.ID}}" type="checkbox" name="is_active" value="true" {{if .IsActive}}checked{{end}}>
                </td>
                <td class="narrow muted">{{index $usage .ID}}</td>
                <td class="actions">
                    <button form="trait-{{.ID}}" type="submit">{{t "common.save"}}</button>
                    {{if $canDelete}}
                        <button form="trait-del-{{.ID}}" class="danger" type="submit">{{t "common.delete"}}</button>
                    {{end}}
                </td>
            </tr>
        {{end}}
        </tbody>
    </table>

    {{range .Traits}}
        <form id="trait-{{.ID}}" method="post" action="/traits/{{.ID}}" hidden>
            <input type="hidden" name="csrf_token" value="{{$csrf}}">
        </form>
        {{if $canDelete}}
            <form id="trait-del-{{.ID}}" method="post" action="/traits/{{.ID}}/delete" hidden
                  onsubmit="return confirm('{{t "traits.delete.confirm" .Name (index $usage .ID)}}')">
                <input type="hidden" name="csrf_token" value="{{$csrf}}">
            </form>
        {{end}}
    {{end}}
    <p class="muted">
        {{t "traits.active.note"}}
    </p>
</div>
{{end}}
