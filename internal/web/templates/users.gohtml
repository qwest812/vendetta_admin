{{define "title"}}{{t "users.title"}}{{end}}

{{define "content"}}
<div class="card">
    <h1>{{t "users.grant"}}</h1>
    {{if .Error}}<p class="error">{{.Error}}</p>{{end}}
    <form class="row-form" method="post" action="/users">
        <input type="hidden" name="csrf_token" value="{{.CSRFToken}}">
        <label>
            {{t "profile.nick"}}
            <input type="text" name="nickname" value="{{.FormNickname}}" required minlength="3" maxlength="32" autocomplete="off">
        </label>
        <label>
            {{t "users.email"}}
            <input type="email" name="email" value="{{.FormEmail}}" required autocomplete="off">
        </label>
        <label>
            {{t "login.password"}}
            <input type="password" name="password" required minlength="12" autocomplete="new-password">
        </label>
        <label>
            {{t "users.role"}}
            <select name="role">
                <option value="user" {{if ne .FormRole "admin"}}selected{{end}}>{{t "role.user"}}</option>
                <option value="admin" {{if eq .FormRole "admin"}}selected{{end}}>{{t "role.admin"}}</option>
            </select>
        </label>
        <button type="submit">{{t "users.create"}}</button>
    </form>
    <p class="muted">{{t "users.note"}}</p>
</div>

<div class="card">
    <h1>{{t "users.heading"}}</h1>
    {{$root := .CurrentUser.IsRoot}}
    {{$me := .CurrentUser.ID}}
    {{/* Список только перечисляет людей: все настройки человека — на его
         странице, по кнопке «Изменить». В строке их было столько, что
         таблица не помещалась на экран, и половина кнопок пряталась за
         его правым краем. */}}
    <div class="table-wrap">
        <table class="stack">
            <thead>
            <tr>
                <th>{{t "profile.nick"}}</th>
                <th>{{t "users.email"}}</th>
                <th>{{t "profile.gameid"}}</th>
                <th>{{t "users.role"}}</th>
                {{if $root}}<th>{{t "users.plan"}}</th><th>{{t "nav.games"}}</th><th class="narrow">{{t "logins.subnets"}}</th>{{end}}
                <th>{{t "common.status"}}</th>
                <th>{{t "users.created"}}</th>
                <th class="actions"></th>
            </tr>
            </thead>
            <tbody>
            {{/* Подсети входов приходят одной картой на всю страницу. Пустую
                 карту проверяем: index по ней роняет отрисовку целиком. */}}
            {{$subnets := .Subnets}}
            {{range .Users}}
                {{$n := 0}}{{if $subnets}}{{$n = index $subnets .ID}}{{end}}
                <tr class="{{if not .IsActive}}inactive{{end}}">
                    <td data-label="{{t "profile.nick"}}">
                        <a class="user-link" href="/users/{{.ID}}/edit">{{.Nickname}}</a>{{if eq .ID $me}} <span class="muted">{{t "users.you"}}</span>{{end}}
                    </td>
                    <td data-label="{{t "users.email"}}">{{if .Email}}{{.Email}}{{else}}<span class="muted">—</span>{{end}}</td>
                    <td data-label="{{t "profile.gameid"}}">{{if .GameID}}<span class="game-id">{{.GameID}}</span>{{else}}<span class="muted">—</span>{{end}}</td>
                    <td data-label="{{t "users.role"}}"><span class="badge role-{{.Role}}">{{role .Role}}</span></td>
                    {{if $root}}
                        <td data-label="{{t "users.plan"}}">{{plan .Plan}}</td>
                        <td data-label="{{t "nav.games"}}">
                            {{if .IsRoot}}<span class="muted">{{t "users.always"}}</span>
                            {{else if .GamesAccess}}{{t "users.games.on"}}
                            {{else}}<span class="muted">{{t "users.games.off"}}</span>{{end}}
                        </td>
                        {{/* Сколько разных подсетей за месяц — только число
                             со ссылкой в журнал: значит оно «посмотрите»,
                             а не «этот аккаунт общий». */}}
                        <td class="narrow" data-label="{{t "logins.subnets"}}">
                            {{if $n}}
                                <a href="/logins?user={{.ID}}" title="{{t "logins.subnets.hint"}}">
                                    {{if ge $n minSubnets}}<span class="badge count">{{$n}}</span>{{else}}{{$n}}{{end}}
                                </a>
                            {{else}}
                                <span class="muted">—</span>
                            {{end}}
                        </td>
                    {{end}}
                    <td data-label="{{t "common.status"}}">{{if .IsActive}}{{t "users.active"}}{{else}}<span class="badge open">{{t "users.blocked"}}</span>{{end}}</td>
                    <td class="muted nowrap" data-label="{{t "users.created"}}">{{date .CreatedAt}}</td>
                    <td class="actions" data-label="">
                        <a class="button ghost" href="/users/{{.ID}}/edit">{{t "users.edit"}}</a>
                    </td>
                </tr>
            {{end}}
            </tbody>
        </table>
    </div>
</div>
{{end}}
